#!/usr/bin/env python3
"""opq-verify — validate Quebec pharmacy billing docs + classify OPQ pharmacists.

Usage:
  opq-verify <doc-id | slug | url>       # validate one Outline doc
  opq-verify --all                       # validate all 11 OPQ docs under Quebec Documents
  opq-verify --file <local.md>           # validate a local markdown file
  opq-verify --json                      # machine-readable output
  opq-verify --strict                    # exit 1 on warnings too (default: only errors)

  opq-verify classify <name-or-license>  # classify a pharmacist against the OPQ index
  opq-verify --classify <name-or-license>
      --human                            # also print a one-line summary to stdout
      --refresh                          # force-refetch the OPQ index (ignore cache TTL)

Doc checks performed:
  TARIFF        — every "XX,XX $" amount must match Infolettre 336-22 or Entente
  REGLE         — every "Règle NN" must be in Entente (1-42)
  ARTICLE       — P-10 r. 3.2 art. 1-22, M-9 r. 12.2.1 art. 1-8
  RAMQ_CODE     — 8-digit codes must exist in sources; alphanumeric must be whitelisted
  INFOLETTRE    — Infolettre NNN-NN must be in known list
  URL           — links return HTTP 200 (GET, follow redirects, 15s timeout)

Classification (SINGLE home for OPQ pharmacist triage — skills/rules POINT here):
  Resolves a person against the OPQ pharmacist index and returns
  {class, licenseNumber, city, matchConfidence}.
    class           = student   (isStudent OR studentLicenseNumber present)
                    | licensed  (licenseNumber present)
                    | unknown   (no match)
    matchConfidence = exact | strong | weak (name) ; exact (license lookup)
  JSON to stdout by default; --human adds a one-line summary.

Source corpus:  ~/.config/opq-verify/sources/
OPQ index cache: ~/.cache/opq-index/pharmacists_index.json (TTL 7 days)
Config:          ~/.config/outline-cli/config.json (api_token, base_url)
"""
from __future__ import annotations
import argparse, json, os, re, subprocess, sys, time, unicodedata
from pathlib import Path
from typing import Dict, List, Optional, Set, Tuple
from urllib.request import Request, urlopen
from urllib.error import HTTPError, URLError

SRC_DIR = Path.home() / '.config' / 'opq-verify' / 'sources'
CONF_PATH = Path.home() / '.config' / 'outline-cli' / 'config.json'

# OPQ pharmacist index — large (~1.9MB, ~11k rows); cache with a TTL and refetch when stale.
OPQ_INDEX_URL = 'https://www.opq.org/wp-content/uploads/pharmacist-search/pharmacists_index.json'
OPQ_CACHE_DIR = Path.home() / '.cache' / 'opq-index'
OPQ_CACHE_FILE = OPQ_CACHE_DIR / 'pharmacists_index.json'
OPQ_CACHE_TTL = 7 * 24 * 3600  # 7 days

# Whitelists built from sources (lazy)
_CACHE: Dict[str, object] = {}

# Alphanumeric RAMQ service codes attested in Entente AQPP-MSSS 2022-2025 + Infolettres
ALPHA_CODES_WHITELIST = {
    '3',   # OP (Opinion pharmaceutique, Règle 10)
    '4',   # COU (initiation contraception urgence, Règle 31)
    'OP', 'V', 'RA', 'AD', 'DC', 'Z', 'W', 'W1', 'W2', 'IU',
    'FE', 'VA', 'EN', 'SP', 'CP', 'HW', 'NA',
    '8K', '8L', 'MK',  # naloxone program codes (Infolettre 267-24)
    'K', 'L', 'M',     # ITSS program codes (K=atteint, L=partenaire, M=TAP contact)
    'AI9', 'DE20', 'RE112', 'RE113', 'VA138',  # pharmacist ITSS/vaccination codes (Manuel RAMQ)
    'DIN',
}

# Known Infolettres RAMQ (pharmacists) — extend as new ones are published
INFOLETTRES_WHITELIST = {
    '261-20', '267-24', '334-23', '336-22', '018-23', '047-23',
}

# Règlements referenced with article numbers
REGLEMENT_ARTICLES = {
    'P-10 r. 3.2': None,
    'M-9 r. 12.2.1': None,
    'P-10 r. 12': None,
}


def load_corpus() -> Dict[str, str]:
    if 'corpus' in _CACHE:
        return _CACHE['corpus']  # type: ignore
    corpus = {}
    if not SRC_DIR.exists():
        sys.exit(f'Source corpus not found at {SRC_DIR}. Populate it before running.')
    for p in SRC_DIR.glob('*.md'):
        corpus[p.stem] = p.read_text()
    _CACHE['corpus'] = corpus
    return corpus


def build_whitelists() -> Dict[str, Set]:
    if 'wl' in _CACHE:
        return _CACHE['wl']  # type: ignore
    corpus = load_corpus()
    wl: Dict[str, Set] = {}

    # Tariffs from Infolettre + Entente
    tariffs: Set[str] = set()
    for key in ('_src-infolettre-336-22', '_src-entente-2022-2025'):
        if key in corpus:
            tariffs |= set(re.findall(r'\b(\d{1,3},\d{2})\b', corpus[key]))
    wl['tariffs'] = tariffs

    # Règles from Entente (accept 1-42)
    if '_src-entente-2022-2025' in corpus:
        regles = set(map(int, re.findall(r'(?:RÈGLE|Règle)\s+(\d+)', corpus['_src-entente-2022-2025'])))
        wl['regles'] = regles
    else:
        wl['regles'] = set()

    # Articles from verbatim règlements
    def extract_arts(text: str) -> Set[int]:
        return set(map(int, re.findall(r'\[(\d+)\.\]\(https?://[^)]*#se:\d+', text)))

    wl['p10_r32_articles'] = extract_arts(corpus.get('_p10-r32-verbatim', ''))
    wl['m9_r1221_articles'] = extract_arts(corpus.get('_m9-r1221-verbatim', ''))
    wl['p10_r12_articles'] = extract_arts(corpus.get('_p10-r12-verbatim', ''))

    # 8-digit RAMQ codes from all sources (keep 009*, 991* prefixes as valid families)
    all_codes: Set[str] = set()
    for t in corpus.values():
        all_codes |= set(re.findall(r'\b(\d{8})\b', t))
    wl['ramq_codes_8digit'] = {c for c in all_codes if c.startswith(('009', '991'))}

    _CACHE['wl'] = wl
    return wl


def fetch_doc_from_outline(doc_id: str) -> Tuple[str, str]:
    """Return (title, markdown_body) via `ol` CLI. doc_id may be UUID, slug, or URL."""
    try:
        out = subprocess.run(['ol', 'doc', 'get', doc_id], capture_output=True, text=True, timeout=30)
    except (FileNotFoundError, subprocess.TimeoutExpired) as e:
        sys.exit(f'Failed to fetch via ol: {e}')
    if out.returncode != 0:
        sys.exit(f'ol doc get failed: {out.stderr}')
    # ol output format: "# Title\nID: ...\nURL: ...\nUpdated: ...\nCollection: ...\n\n<body>"
    lines = out.stdout.split('\n')
    title = lines[0].lstrip('# ').strip() if lines else doc_id
    body_start = 0
    for i, l in enumerate(lines):
        if l.startswith('Collection:'):
            body_start = i + 1
            break
    body = '\n'.join(lines[body_start:]).strip()
    return title, body


BILLING_CONTEXT_RE = re.compile(
    r'\b(?:tarif|facturation|facturable|payable|rémunération|honoraire|code\s+(?:de\s+)?service|'
    r'LAM|RGAM|règle|infolettre|Annexe\s+III|entente|AQPP)\b',
    re.IGNORECASE,
)

# Patterns that indicate a $ amount is a drug price, not a RAMQ tariff
DRUG_PRICE_RE = re.compile(
    r'\b(?:prix|coût|co[ûu]t\w*|\$/(?:cp|co|mL|mois|comprimé|jour|dose|lavement|supp)|/cp|/mois|/jour|'
    r'pharmacare|formulary)\b',
    re.IGNORECASE,
)


def looks_like_drug_price(body: str, span: Tuple[int, int], window: int = 60) -> bool:
    start = max(0, span[0] - window)
    end = min(len(body), span[1] + window)
    return bool(DRUG_PRICE_RE.search(body[start:end]))


def has_billing_context(body: str, span: Tuple[int, int], window: int = 120) -> bool:
    start = max(0, span[0] - window)
    end = min(len(body), span[1] + window)
    return bool(BILLING_CONTEXT_RE.search(body[start:end]))


def check_tariffs(body: str, wl: Dict[str, Set]) -> List[Dict]:
    findings = []
    seen: Set[str] = set()
    # Build float lookup for multiple detection
    tariff_floats = {float(t.replace(',', '.')) for t in wl['tariffs']}
    for m in re.finditer(r'\b(\d{1,3},\d{2})\s*\$', body):
        val = m.group(1)
        if val in seen: continue
        seen.add(val)
        if val in wl['tariffs']:
            continue
        # Require billing context — avoids clinical doc price noise
        if not has_billing_context(body, m.span()):
            continue
        # Exclude drug prices (clinical tables with RAMQ coverage annotations)
        if looks_like_drug_price(body, m.span()):
            continue
        # Check if val is an integer multiple (2..10) of any known tariff (derivative calculation)
        try:
            vf = float(val.replace(',', '.'))
            is_multiple = any(abs(vf - tf * n) < 0.01 for tf in tariff_floats for n in range(2, 11))
        except ValueError:
            is_multiple = False
        if is_multiple:
            findings.append({
                'type': 'TARIFF',
                'severity': 'warning',
                'claim': f'{val} $',
                'message': f'Tariff {val} $ not directly in sources, but matches a multiple of a known tariff (likely derivative example).',
            })
        else:
            findings.append({
                'type': 'TARIFF',
                'severity': 'error',
                'claim': f'{val} $',
                'message': f'Tariff {val} $ not in Infolettre 336-22 or Entente. Possibly hallucinated or outdated.',
            })
    return findings


def check_regles(body: str, wl: Dict[str, Set]) -> List[Dict]:
    findings = []
    seen: Set[int] = set()
    # "Règle N" without Entente/billing context is usually a figure/table label in clinical docs
    for m in re.finditer(r'Règles?\s+(\d+)(?:\s*[-–]\s*(\d+))?', body):
        if not has_billing_context(body, m.span()):
            continue
        nums = [int(m.group(1))]
        if m.group(2):
            try:
                for n in range(int(m.group(1)), int(m.group(2)) + 1):
                    nums.append(n)
            except ValueError:
                pass
        for n in nums:
            if n in seen: continue
            seen.add(n)
            if n not in wl['regles']:
                findings.append({
                    'type': 'REGLE',
                    'severity': 'error',
                    'claim': f'Règle {n}',
                    'message': f'Règle {n} not in Entente AQPP-MSSS (attested: 1-{max(wl["regles"]) if wl["regles"] else "?"}).',
                })
    return findings


def check_articles(body: str, wl: Dict[str, Set]) -> List[Dict]:
    findings = []
    # P-10 r. 3.2 art. X
    for m in re.finditer(r'P[-‑]10\s*r\.?\s*3\.2\s*(?:\w+\.?\s*)?art\.?\s+(\d+)', body):
        art = int(m.group(1))
        if art not in wl['p10_r32_articles']:
            findings.append({
                'type': 'ARTICLE',
                'severity': 'error',
                'claim': f'P-10 r. 3.2 art. {art}',
                'message': f'Art. {art} not in P-10 r. 3.2 (attested: 1-{max(wl["p10_r32_articles"])}).',
            })
    # M-9 r. 12.2.1 art. X
    for m in re.finditer(r'M[-‑]9\s*r\.?\s*12\.2\.1\s*(?:\w+\.?\s*)?art\.?\s+(\d+)', body):
        art = int(m.group(1))
        if art not in wl['m9_r1221_articles']:
            findings.append({
                'type': 'ARTICLE',
                'severity': 'error',
                'claim': f'M-9 r. 12.2.1 art. {art}',
                'message': f'Art. {art} not in M-9 r. 12.2.1 (attested: 1-{max(wl["m9_r1221_articles"])}).',
            })
    return findings


def check_ramq_codes(body: str, wl: Dict[str, Set]) -> List[Dict]:
    findings = []
    # 8-digit codes — only flag if billing context AND looks like RAMQ (009/991 prefix families)
    seen8: Set[str] = set()
    for m in re.finditer(r'\b(\d{8})\b', body):
        c = m.group(1)
        if c in seen8: continue
        seen8.add(c)
        if c in wl['ramq_codes_8digit']:
            continue
        # Only flag if it matches RAMQ prefix pattern AND has billing context
        if not c.startswith(('009', '991')):
            continue
        if not has_billing_context(body, m.span()):
            continue
        findings.append({
            'type': 'RAMQ_CODE',
            'severity': 'error',
            'claim': f'code {c}',
            'message': f'8-digit RAMQ-pattern code {c} not found in source corpus. Verify against Infolettre 336-22 / AQPP Tableau synthèse.',
        })

    # Suspicious 5-digit "codes" that look like RAMQ (hallucination pattern: 14031, 14033)
    for m in re.finditer(r'\bcode[s]?\s+["\'`]?(\d{5})\b', body, re.IGNORECASE):
        c = m.group(1)
        findings.append({
            'type': 'RAMQ_CODE',
            'severity': 'error',
            'claim': f'code {c} (5-digit)',
            'message': f'5-digit "{c}" presented as code — RAMQ codes are alphanumeric (OP/V/...) or 8-digit (009xxxxx). Likely hallucinated.',
        })

    # Alphanumeric codes
    seen_alpha: Set[str] = set()
    for m in re.finditer(r'\bcode[s]?\s+(?:de\s+)?(?:service\s+)?["\'`]?([A-Z]{1,3}[0-9]?)\b', body):
        c = m.group(1)
        if c in seen_alpha: continue
        seen_alpha.add(c)
        if c not in ALPHA_CODES_WHITELIST:
            findings.append({
                'type': 'RAMQ_CODE',
                'severity': 'warning',
                'claim': f'code {c}',
                'message': f'Alphanumeric code "{c}" not in whitelist. Verify against Infolettre or Manuel.',
            })
    return findings


def check_infolettres(body: str) -> List[Dict]:
    findings = []
    seen: Set[str] = set()
    for m in re.finditer(r'Infolettre\s+(?:RAMQ\s+)?(\d{3}-\d{2})', body):
        n = m.group(1)
        if n in seen: continue
        seen.add(n)
        if n not in INFOLETTRES_WHITELIST:
            findings.append({
                'type': 'INFOLETTRE',
                'severity': 'warning',
                'claim': f'Infolettre {n}',
                'message': f'Infolettre {n} not in known list ({sorted(INFOLETTRES_WHITELIST)}). May be new — verify.',
            })
    return findings


# Domains known to block bot User-Agents or be very slow — skip reachability check
# Trust that URLs on these domains are valid (manual verification recommended).
URL_ALLOWLIST_DOMAINS = {
    'www.canada.ca',    # Akamai bot protection
    'canada.ca',
    'www.inesss.qc.ca', # occasional slow response
    'web.archive.org',  # slow, rate-limited
}


def check_urls(body: str) -> List[Dict]:
    findings = []
    urls = set(re.findall(r'https?://[^\s\)\]>"\']+', body))
    for url in sorted(urls):
        # Skip known bot-protected / slow government domains
        from urllib.parse import urlparse
        host = urlparse(url).hostname or ''
        if host in URL_ALLOWLIST_DOMAINS:
            continue
        try:
            req = Request(url, headers={'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64) opq-verify/1.0'}, method='GET')
            with urlopen(req, timeout=30) as resp:
                if resp.status >= 400:
                    findings.append({
                        'type': 'URL',
                        'severity': 'error',
                        'claim': url,
                        'message': f'HTTP {resp.status}',
                    })
        except HTTPError as e:
            if e.code in (404, 410):
                findings.append({'type': 'URL', 'severity': 'error', 'claim': url, 'message': f'HTTP {e.code}'})
            elif e.code in (403, 401):
                findings.append({'type': 'URL', 'severity': 'warning', 'claim': url, 'message': f'HTTP {e.code} (may be bot-protected)'})
        except URLError as e:
            findings.append({'type': 'URL', 'severity': 'warning', 'claim': url, 'message': f'URL unreachable: {e.reason}'})
        except Exception as e:
            findings.append({'type': 'URL', 'severity': 'warning', 'claim': url, 'message': f'URL check failed: {e}'})
    return findings


def verify_doc(identifier: str, body: str | None = None, title: str | None = None, skip_urls: bool = False) -> Dict:
    wl = build_whitelists()
    if body is None:
        title, body = fetch_doc_from_outline(identifier)
    findings = []
    findings.extend(check_tariffs(body, wl))
    findings.extend(check_regles(body, wl))
    findings.extend(check_articles(body, wl))
    findings.extend(check_ramq_codes(body, wl))
    findings.extend(check_infolettres(body))
    if not skip_urls:
        findings.extend(check_urls(body))
    return {'doc': identifier, 'title': title or '', 'findings': findings}


def format_report(result: Dict) -> str:
    lines = [f'\n══ {result["title"]} ({result["doc"]})']
    errs = [f for f in result['findings'] if f['severity'] == 'error']
    warns = [f for f in result['findings'] if f['severity'] == 'warning']
    if not result['findings']:
        lines.append('  ✓ OK — no findings')
        return '\n'.join(lines)
    for f in errs:
        lines.append(f'  ✗ [{f["type"]}] {f["claim"]} — {f["message"]}')
    for f in warns:
        lines.append(f'  ⚠ [{f["type"]}] {f["claim"]} — {f["message"]}')
    lines.append(f'  Summary: {len(errs)} error(s), {len(warns)} warning(s)')
    return '\n'.join(lines)


