# ── OPQ pharmacist classification ─────────────────────────────────────────────

def _norm(s: str) -> str:
    """Accent- and case-insensitive normalization for name matching."""
    if not s:
        return ''
    nfkd = unicodedata.normalize('NFKD', s)
    stripped = ''.join(c for c in nfkd if not unicodedata.combining(c))
    return re.sub(r'\s+', ' ', stripped).strip().lower()


def load_opq_index(refresh: bool = False) -> List[Dict]:
    """Return the OPQ pharmacist index, refetching when cache is missing/stale."""
    if 'opq_index' in _CACHE and not refresh:
        return _CACHE['opq_index']  # type: ignore
    fresh = (
        not refresh
        and OPQ_CACHE_FILE.exists()
        and (time.time() - OPQ_CACHE_FILE.stat().st_mtime) < OPQ_CACHE_TTL
    )
    if fresh:
        try:
            data = json.loads(OPQ_CACHE_FILE.read_text())
            _CACHE['opq_index'] = data
            return data
        except (json.JSONDecodeError, OSError):
            pass  # corrupt cache → refetch
    # Fetch and cache
    try:
        req = Request(OPQ_INDEX_URL, headers={'User-Agent': 'opq-verify/1.0'}, method='GET')
        with urlopen(req, timeout=30) as resp:
            raw = resp.read()
        data = json.loads(raw)
    except (HTTPError, URLError, json.JSONDecodeError, OSError) as e:
        # Network failed — fall back to a stale cache if we have one
        if OPQ_CACHE_FILE.exists():
            try:
                data = json.loads(OPQ_CACHE_FILE.read_text())
                print(f'[opq-verify] warning: fetch failed ({e}); using stale cache', file=sys.stderr)
                _CACHE['opq_index'] = data
                return data
            except (json.JSONDecodeError, OSError):
                pass
        sys.exit(f'Failed to fetch OPQ index and no usable cache: {e}')
    OPQ_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    OPQ_CACHE_FILE.write_bytes(raw)
    _CACHE['opq_index'] = data
    return data


def _classify_entry(entry: Dict) -> str:
    if entry.get('isStudent') or entry.get('studentLicenseNumber'):
        return 'student'
    if entry.get('licenseNumber'):
        return 'licensed'
    return 'unknown'


def classify_person(query: str, refresh: bool = False) -> Dict:
    """Resolve `query` (name or license number) against the OPQ index.

    Returns {class, licenseNumber, city, matchConfidence, matchedName, note}.
    """
    index = load_opq_index(refresh=refresh)
    q = query.strip()

    # License-number lookup: digits-only query matches license or student license exactly.
    if re.fullmatch(r'\d{3,6}', q):
        for e in index:
            if q in (e.get('licenseNumber'), e.get('studentLicenseNumber')):
                return {
                    'query': query, 'class': _classify_entry(e),
                    'licenseNumber': e.get('licenseNumber') or e.get('studentLicenseNumber'),
                    'city': e.get('city'), 'matchConfidence': 'exact',
                    'matchedName': e.get('fullName'), 'note': None,
                }

    # Name lookup — accent/case-insensitive.
    qn = _norm(q)
    if not qn:
        return {'query': query, 'class': 'unknown', 'licenseNumber': None,
                'city': None, 'matchConfidence': None, 'matchedName': None,
                'note': 'empty query'}
    qtokens = set(qn.split())

    exact, substr, token = [], [], []
    for e in index:
        name_n = _norm(e.get('fullName', ''))
        if not name_n:
            continue
        if name_n == qn:
            exact.append(e)
        elif qn in name_n:
            substr.append(e)
        elif qtokens and qtokens <= set(name_n.split()):
            token.append(e)  # all query tokens present (handles word order / extra middle names)

    if exact:
        bucket, conf = exact, 'exact'
    elif substr:
        bucket, conf = substr, 'strong'
    elif token:
        bucket, conf = token, 'strong'
    else:
        return {'query': query, 'class': 'unknown', 'licenseNumber': None,
                'city': None, 'matchConfidence': None, 'matchedName': None,
                'note': 'no match in OPQ index'}

    note = None
    if len(bucket) > 1:
        # Multiple candidates → return best (prefer licensed over student), flag ambiguity.
        bucket = sorted(bucket, key=lambda e: (e.get('isStudent') is True, _norm(e.get('fullName', ''))))
        conf = 'weak'
        others = ', '.join(
            f"{e.get('fullName')} ({e.get('licenseNumber') or e.get('studentLicenseNumber')})"
            for e in bucket[1:6]
        )
        note = f'{len(bucket)} matches; returning best. Others: {others}'
    best = bucket[0]
    return {
        'query': query, 'class': _classify_entry(best),
        'licenseNumber': best.get('licenseNumber') or best.get('studentLicenseNumber'),
        'city': best.get('city'), 'matchConfidence': conf,
        'matchedName': best.get('fullName'), 'note': note,
    }


def classify_human_line(r: Dict) -> str:
    if r['class'] == 'unknown':
        return f'✗ {r["query"]} → unknown ({r.get("note") or "no match"})'
    parts = [f'✓ {r["query"]} → {r["class"]}']
    if r.get('matchedName') and _norm(r['matchedName']) != _norm(r['query']):
        parts.append(f'[{r["matchedName"]}]')
    if r.get('licenseNumber'):
        parts.append(f'lic {r["licenseNumber"]}')
    if r.get('city'):
        parts.append(r['city'])
    parts.append(f'({r["matchConfidence"]})')
    line = ' '.join(parts)
    if r.get('note'):
        line += f' — {r["note"]}'
    return line


def run_classify(query: str, as_json: bool, human: bool, refresh: bool) -> int:
    r = classify_person(query, refresh=refresh)
    if as_json or not human:
        print(json.dumps(r, ensure_ascii=False))
    if human:
        print(classify_human_line(r))
    else:
        # Default: JSON on stdout, summary on stderr (so piped callers stay clean).
        print(classify_human_line(r), file=sys.stderr)
    return 0 if r['class'] != 'unknown' else 1


def main() -> int:
    # `classify` subcommand (positional) — keep it out of the mutually-exclusive doc group.
    argv = sys.argv[1:]
    if argv and argv[0] == 'classify':
        sub = argparse.ArgumentParser(prog='opq-verify classify',
                                      description='Classify an OPQ pharmacist (single home for triage).')
        sub.add_argument('query', help='Pharmacist name or license number')
        sub.add_argument('--json', action='store_true', help='JSON only on stdout (default already JSON)')
        sub.add_argument('--human', action='store_true', help='Print a one-line human summary to stdout')
        sub.add_argument('--refresh', action='store_true', help='Force-refetch the OPQ index')
        a = sub.parse_args(argv[1:])
        return run_classify(a.query, a.json, a.human, a.refresh)

    ap = argparse.ArgumentParser(description='Validate Quebec pharmacy billing docs against ground-truth sources.')
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument('doc', nargs='?', help='Document ID, slug, or URL (Outline)')
    g.add_argument('--all', action='store_true', help='Validate all 11 OPQ docs')
    g.add_argument('--file', help='Validate a local markdown file')
    g.add_argument('--collection', help='Validate every doc in an Outline collection (by ID)')
    g.add_argument('--classify', metavar='NAME-OR-LICENSE',
                   help='Classify an OPQ pharmacist (equivalent to: classify <query>)')
    ap.add_argument('--json', action='store_true', help='Machine-readable JSON output')
    ap.add_argument('--strict', action='store_true', help='Exit 1 on warnings too')
    ap.add_argument('--skip-urls', action='store_true', help='Skip URL reachability checks (faster)')
    ap.add_argument('--human', action='store_true', help='[classify] print a one-line summary to stdout')
    ap.add_argument('--refresh', action='store_true', help='[classify] force-refetch the OPQ index')
    args = ap.parse_args()

    if args.classify:
        return run_classify(args.classify, args.json, args.human, args.refresh)

    results = []
    if args.all:
        for doc_id, title in OPQ_DOCS:
            print(f'Checking: {title}...', file=sys.stderr, flush=True)
            results.append(verify_doc(doc_id, skip_urls=args.skip_urls))
    elif args.collection:
        out = subprocess.run(['ol', 'doc', 'list', '--collection', args.collection, '--ids-only'],
                             capture_output=True, text=True, timeout=60)
        if out.returncode != 0:
            sys.exit(f'ol doc list failed: {out.stderr}')
        doc_ids = [l.strip() for l in out.stdout.splitlines() if l.strip()]
        print(f'Found {len(doc_ids)} docs in collection {args.collection}', file=sys.stderr)
        for i, doc_id in enumerate(doc_ids, 1):
            print(f'[{i}/{len(doc_ids)}] {doc_id}', file=sys.stderr, flush=True)
            try:
                results.append(verify_doc(doc_id, skip_urls=args.skip_urls))
            except SystemExit as e:
                print(f'  SKIP ({e})', file=sys.stderr)
    elif args.file:
        body = Path(args.file).read_text()
        results.append(verify_doc(args.file, body=body, title=Path(args.file).name, skip_urls=args.skip_urls))
    else:
        results.append(verify_doc(args.doc, skip_urls=args.skip_urls))

    if args.json:
        print(json.dumps(results, ensure_ascii=False, indent=2))
    else:
        for r in results:
            print(format_report(r))
        # Aggregate summary
        total_err = sum(len([f for f in r['findings'] if f['severity'] == 'error']) for r in results)
        total_warn = sum(len([f for f in r['findings'] if f['severity'] == 'warning']) for r in results)
        print(f'\n══ TOTAL: {len(results)} doc(s), {total_err} error(s), {total_warn} warning(s)')

    has_err = any(any(f['severity'] == 'error' for f in r['findings']) for r in results)
    has_warn = any(any(f['severity'] == 'warning' for f in r['findings']) for r in results)
    if has_err or (args.strict and has_warn):
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
