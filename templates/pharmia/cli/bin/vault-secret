#!/usr/bin/env bash
# vault-secret <KEY> — fetch ONE machine secret value from HashiCorp Vault
# (secret/agents/<KEY>, KV-v2, field `value`) and print it to stdout.
#
# WHY: Paperclip agents must NOT carry broad secrets in their ambient environment
# (an `env`/`printenv` dump would otherwise persist them into a run transcript —
# see the 2026-06-15 leak). Tooling fetches the single value it needs ON DEMAND
# instead. The bootstrap credential is a READ-ONLY, secret/agents/*-scoped AppRole
# (`agents-ro`) whose role_id/secret_id live in a 0600 file OUTSIDE the shell env,
# so an environment dump never reveals them.
#
# Auth precedence: $VAULT_TOKEN (per-run, if the launcher injected one) → cached
# short-TTL token → AppRole login using the 0600 creds file. Token is cached under
# the runtime dir (0600) and reused until it stops validating.
set -euo pipefail

KEY="${1:?usage: vault-secret <KEY>}"
VAULT_ADDR="${VAULT_ADDR:-https://vault.bentostudio.io}"
CRED="${VAULT_AGENT_APPROLE:-$HOME/.config/pharmia-vault/agents-ro.env}"
CACHE="${XDG_RUNTIME_DIR:-/tmp}/.vault-agents-ro-token.$(id -u)"

api() { curl -sf --max-time 10 "$@"; }

valid() { local t="$1"; [ -n "$t" ] && api -H "X-Vault-Token: $t" "$VAULT_ADDR/v1/auth/token/lookup-self" >/dev/null 2>&1; }

login() {
  [ -r "$CRED" ] || { echo "vault-secret: creds file $CRED missing/unreadable" >&2; return 3; }
  local rid sid t
  rid="$(grep -E '^[[:space:]]*VAULT_RO_ROLE_ID=' "$CRED" | head -1 | cut -d= -f2- | tr -d '"'"'"' \r')"
  sid="$(grep -E '^[[:space:]]*VAULT_RO_SECRET_ID=' "$CRED" | head -1 | cut -d= -f2- | tr -d '"'"'"' \r')"
  [ -n "$rid" ] && [ -n "$sid" ] || { echo "vault-secret: role_id/secret_id absent in $CRED" >&2; return 3; }
  t="$(api "$VAULT_ADDR/v1/auth/approle/login" \
        --data-binary "$(jq -nc --arg r "$rid" --arg s "$sid" '{role_id:$r,secret_id:$s}')" \
        | jq -r '.auth.client_token // empty')"
  [ -n "$t" ] || { echo "vault-secret: AppRole login failed" >&2; return 4; }
  ( umask 077; printf '%s' "$t" >"$CACHE" )
  printf '%s' "$t"
}

token=""
if [ -n "${VAULT_TOKEN:-}" ] && valid "$VAULT_TOKEN"; then
  token="$VAULT_TOKEN"
elif [ -s "$CACHE" ] && valid "$(cat "$CACHE" 2>/dev/null)"; then
  token="$(cat "$CACHE")"
else
  token="$(login)"
fi

val="$(api -H "X-Vault-Token: $token" "$VAULT_ADDR/v1/secret/data/agents/$KEY" 2>/dev/null \
        | jq -r '.data.data.value // empty')"
[ -n "$val" ] || { echo "vault-secret: no value at secret/agents/$KEY" >&2; exit 5; }
printf '%s' "$val"
