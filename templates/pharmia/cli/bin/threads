  : | MODE="$MODE" THREAD_ID="$THREAD_ID" ENV="$ENV" \
      LANGFUSE="$LANGFUSE" SKIP_PG="$SKIP_PG" \
      OBS="$OBS" OBS_PAD="$OBS_PAD" \
      python3 -c "$RENDER_SCRIPT"
