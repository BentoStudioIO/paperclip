#!/usr/bin/env bash
set -euo pipefail

CONF_DIR="${HOME}/.config/twenty"
CONF_FILE="${CONF_DIR}/config"

# Capture explicit env overrides BEFORE defaults/config overwrite them. Presence
# of either flags the cache as tainted so `TWENTY_SSH_HOST=bogus twenty token`
# actually tries bogus instead of returning whatever's cached.
TWENTY_SSH_HOST_OVERRIDE="${TWENTY_SSH_HOST:-}"
TWENTY_API_KEY_ID_OVERRIDE="${TWENTY_API_KEY_ID:-}"

# Defaults (overridable via config file)
TWENTY_URL="${TWENTY_URL:-https://twenty.bentostudio.io}"
TWENTY_SSH_HOST="${TWENTY_SSH_HOST:-bento}"
TWENTY_CONTAINER="${TWENTY_CONTAINER:-bento-studio-twenty-w9iq7f-twenty-server-1}"
# Postgres container: derived from the server container name unless overridden.
TWENTY_PG_CONTAINER="${TWENTY_PG_CONTAINER:-${TWENTY_CONTAINER/-twenty-server-1/-twenty-postgres-1}}"
TWENTY_WORKSPACE_ID="${TWENTY_WORKSPACE_ID:-1475ef88-e279-4c28-8696-beefd02a2c87}"
TWENTY_API_KEY_ID="${TWENTY_API_KEY_ID:-70256598-2eec-4e8d-b9eb-81222a69492d}"

# Load config overrides (env overrides already captured above so config can't erase them)
[[ -f "$CONF_FILE" ]] && source "$CONF_FILE"

# Token cache (1h TTL)
TOKEN_CACHE="${CONF_DIR}/.token_cache"

usage() {
  local code="${1:-0}"
  cat <<'EOF'
Usage: twenty [--json] [--dry-run] <command> [args]

Global flags:
  --json            Emit raw JSON instead of human-formatted output
                    (applies to: objects, fields, person/company/opportunity get)
  --dry-run         Print the payload that would be sent without calling the API
                    (applies to: field-create, all high-level write commands)

Low-level commands:
  token             Generate and print a fresh API token
  gql <query>       Execute GraphQL against /api (data API)
  meta <query>      Execute GraphQL against /metadata (metadata API)
  rest <method> <path> [json]
                    Execute REST API call (e.g. GET /rest/metadata/objects)
  objects           List all object metadata (name + id)
  fields <object>   List fields on an object (by nameSingular)
  field-create <objectId> <name> <label> <type> [json-extras]
                    Create a custom field on an object
  doctor [--fix]    Detect/repair v2-migration schema gaps (NULL applicationId,
                    empty navigationMenuItem). Reads/writes DB via SSH+psql.

High-level commands (no hand-written GraphQL; run '<cmd> --help' for flags):
  person get <email|phone|name>   Look up a person (email, then phone, then name)
  person upsert ...               Create-or-update a person by primaryEmail
  company upsert ...              Create-or-update a company by name
  opportunity get --person <id>   Find an opportunity (dedupe by point of contact)
  opportunity create ...          Create an opportunity
  opportunity update <id> ...     Update an opportunity's stage / close date
  note add ...                    Create a note (markdown) + link it to records
  task create ...                 Create a task (+ optional record links)

Enums (discover live with 'twenty fields <obj>' + 'twenty meta'):
  person.source   PHARMIA_SIGNUP INBOUND_MEETING REFERRAL COLD SOCIAL EVENT PARTNER_REFERRAL
  person.group    PHARMACIST_OWNER PHARMACIST VC INFLUENCER MENTOR CLIENT SALES PARTNER
  person.outreachStatus  NOT_CONTACTED CONTACTED INTERESTED MEETING_BOOKED IN_DISCUSSION CONVERTED NOT_INTERESTED
  opportunity.stage  NEW SCREENING MEETING PROPOSAL DONE CLIENT LATER
  task.status     TODO IN_PROGRESS PLANNED DONE WONT_DO WAITING LATER

Examples:
  twenty objects
  twenty fields person
  twenty person get jane@pharmacie.qc.ca
  twenty person upsert --first Jane --last Tremblay --email jane@pharmacie.qc.ca \
    --phone +15145551234 --city Montreal --source INBOUND_MEETING --group PHARMACIST_OWNER
  twenty opportunity create --name "Pharmacie Tremblay" --stage SCREENING --person <personId>
  twenty note add --title "Meeting" --md "## Notes" --link person:<id> --link opportunity:<id>
  twenty task create --title "Intro to VC" --due 2026-07-01 --link person:<id>

Token is auto-generated via SSH to the Twenty server container (1h cache).
Config: ~/.config/twenty/config
EOF
  exit "$code"
}

ensure_conf_dir() {
  [[ -d "$CONF_DIR" ]] || mkdir -p "$CONF_DIR"
}

get_token() {
  ensure_conf_dir

  # Explicit env overrides bypass cache — caller wants fresh auth against a
  # different host/key ID, not whatever happened to be cached for the default.
  local bypass_cache=0
  if [[ -n "${TWENTY_SSH_HOST_OVERRIDE:-}" || -n "${TWENTY_API_KEY_ID_OVERRIDE:-}" ]]; then
    bypass_cache=1
  fi

  # Cache hit = JWT's own `exp` is still >300s away. Ignores mtime entirely:
  # stale clocks and long pauses between calls don't matter, only the token
  # the server will actually accept.
  if (( bypass_cache == 0 )) && [[ -f "$TOKEN_CACHE" ]]; then
    local cached exp_ts now
    cached=$(cat "$TOKEN_CACHE")
    exp_ts=$(jwt_exp "$cached" || echo 0)
    now=$(date +%s)
    if (( exp_ts > 0 && now < exp_ts - 300 )); then
      echo "$cached"
      return
    fi
  fi

  # Generate fresh token via SSH. Temporarily disable errexit so a bogus host
  # doesn't nuke the whole script before we can emit the friendly diagnostic.
  local token ssh_status
  set +e
  token=$(ssh "$TWENTY_SSH_HOST" "docker exec $TWENTY_CONTAINER node -e \"
const crypto = require('crypto');
const jwt = require('jsonwebtoken');
const secret = crypto.createHash('sha256')
  .update(process.env.APP_SECRET + '$TWENTY_WORKSPACE_ID' + 'API_KEY')
  .digest('hex');
console.log(jwt.sign(
  { sub: '$TWENTY_WORKSPACE_ID', type: 'API_KEY', workspaceId: '$TWENTY_WORKSPACE_ID', jti: '$TWENTY_API_KEY_ID' },
  secret,
  { expiresIn: '1h' }
));
\"" 2>/dev/null)
  ssh_status=$?
  set -e

  if (( ssh_status != 0 )) || [[ -z "$token" ]]; then
    echo "twenty: SSH to $TWENTY_SSH_HOST failed — run 'ssh $TWENTY_SSH_HOST true' to diagnose" >&2
    exit 1
  fi

  # Only cache when we're using the default host+key (caching an override'd
  # token would poison subsequent default-host calls).
  if (( bypass_cache == 0 )); then
    echo "$token" > "$TOKEN_CACHE"
  fi
  echo "$token"
}

# Decode a JWT's `exp` claim. base64url -> base64, pad, decode, jq.
jwt_exp() {
  local jwt="$1" payload
  payload="${jwt#*.}"       # strip header
  payload="${payload%%.*}"  # strip signature
  [[ -z "$payload" ]] && return 1
  # base64url -> base64 + padding
  payload="${payload//-/+}"
  payload="${payload//_//}"
  while (( ${#payload} % 4 )); do payload+="="; done
  echo "$payload" | base64 -d 2>/dev/null | jq -r '.exp // empty'
}

api_call() {
  local endpoint="$1"
  local query="$2"
  local token
  token=$(get_token)

  curl -s -X POST "${TWENTY_URL}${endpoint}" \
    -H "Authorization: Bearer $token" \
    -H "Content-Type: application/json" \
    -d "$query"
}

rest_call() {
  local method="$1"
  local path="$2"
  local body="${3:-}"
  local token
  token=$(get_token)

  local curl_args=(-s -X "$method" "${TWENTY_URL}${path}" -H "Authorization: Bearer $token" -H "Content-Type: application/json")
  [[ -n "$body" ]] && curl_args+=(-d "$body")

  curl "${curl_args[@]}"
}

# --- High-level data-API helpers -------------------------------------------
# All write commands route through here so they share dry-run, error surfacing,
# and a single place where the GraphQL request is built. `query` is the GraphQL
# source string; `vars_json` is a JSON object of variables (default {}). Risky
# user input ALWAYS travels as a variable, never string-interpolated into the
# query text — enums are the only thing kept inline (GraphQL enums aren't
# strings). On any GraphQL `errors`, prints them to stderr and exits 1 so a
# failed write never looks like a success to a caller piping the output.

data_gql() {
  local query="$1" vars_json="${2:-{\}}"
  local payload
  payload=$(jq -nc --arg q "$query" --argjson v "$vars_json" '{query: $q, variables: $v}')
  if (( DRY_RUN )); then
    echo "$payload" | jq .
    return 0
  fi
  local resp
  resp=$(api_call "/graphql" "$payload")
  if echo "$resp" | jq -e '.errors' >/dev/null 2>&1; then
    echo "twenty: GraphQL error:" >&2
    echo "$resp" | jq -r '.errors[].message' >&2 2>/dev/null || echo "$resp" >&2
    exit 1
  fi
  echo "$resp"
}

# Resolve a person by email (exact), then phone (exact), then name (ilike on
# first OR last). Echoes the matched node JSON (or empty). First match wins.
person_lookup() {
  local needle="$1" resp node
  # email
  resp=$(data_gql '{ people(filter: { emails: { primaryEmail: { eq: $e } } }, first: 1) { edges { node { id name { firstName lastName } emails { primaryEmail } phones { primaryPhoneNumber } city jobTitle source group pharmiaTenant } } } }' "$(jq -nc --arg e "$needle" '{e:$e}')" 2>/dev/null || true)
  node=$(echo "$resp" | jq -c '.data.people.edges[0].node // empty' 2>/dev/null)
  [[ -n "$node" ]] && { echo "$node"; return 0; }
  # phone (strip non-digits/leading +)
  resp=$(data_gql '{ people(filter: { phones: { primaryPhoneNumber: { eq: $p } } }, first: 1) { edges { node { id name { firstName lastName } emails { primaryEmail } phones { primaryPhoneNumber } city jobTitle source group pharmiaTenant } } } }' "$(jq -nc --arg p "$needle" '{p:$p}')" 2>/dev/null || true)
  node=$(echo "$resp" | jq -c '.data.people.edges[0].node // empty' 2>/dev/null)
  [[ -n "$node" ]] && { echo "$node"; return 0; }
  # name ilike
  resp=$(data_gql '{ people(filter: { or: [ { name: { firstName: { ilike: $n } } }, { name: { lastName: { ilike: $n } } } ] }, first: 1) { edges { node { id name { firstName lastName } emails { primaryEmail } phones { primaryPhoneNumber } city jobTitle source group pharmiaTenant } } } }' "$(jq -nc --arg n "%${needle}%" '{n:$n}')" 2>/dev/null || true)
  echo "$resp" | jq -c '.data.people.edges[0].node // empty' 2>/dev/null
}

# Look up a single person by exact primaryEmail; echoes id or empty.
person_id_by_email() {
  local email="$1" resp
  resp=$(data_gql '{ people(filter: { emails: { primaryEmail: { eq: $e } } }, first: 1) { edges { node { id } } } }' "$(jq -nc --arg e "$email" '{e:$e}')")
  echo "$resp" | jq -r '.data.people.edges[0].node.id // empty'
}

# Look up a single company by exact name; echoes id or empty.
company_id_by_name() {
  local name="$1" resp
  resp=$(data_gql '{ companies(filter: { name: { eq: $n } }, first: 1) { edges { node { id } } } }' "$(jq -nc --arg n "$name" '{n:$n}')")
  echo "$resp" | jq -r '.data.companies.edges[0].node.id // empty'
}

# Run SQL (read from stdin) against the workspace DB via SSH + the postgres
# container. base64 the payload so arbitrary SQL survives the ssh/docker layers
# intact (no quoting hell). Output is pipe-separated, header-less.
pg_exec() {
  local b64
  b64=$(base64 -w0 2>/dev/null || base64)
  ssh "$TWENTY_SSH_HOST" "PGU=\$(docker exec $TWENTY_PG_CONTAINER printenv POSTGRES_USER 2>/dev/null); echo '$b64' | base64 -d | docker exec -i $TWENTY_PG_CONTAINER psql -U \"\$PGU\" -d twenty -t -A -F'|'"
}

case "${1:-}" in
  -h|--help|help)
    usage 0
    ;;
esac

[[ $# -lt 1 ]] && usage 1

# Parse global flags (currently just --json). Kept simple: single-pass rewrite
# of the arg list rather than dragging getopts in.
JSON_OUT=0
DRY_RUN=0
args=()
for arg in "$@"; do
  case "$arg" in
    --json)    JSON_OUT=1 ;;
    --dry-run) DRY_RUN=1 ;;
    *)         args+=("$arg") ;;
  esac
done
set -- "${args[@]}"

CMD="$1"
shift

case "$CMD" in
  token)
    get_token
    ;;

  gql)
    [[ $# -lt 1 ]] && echo "Usage: twenty gql <query>" >&2 && exit 1
    api_call "/graphql" "$(jq -nc --arg q "$1" '{query: $q}')" | jq .
    ;;

  meta)
    [[ $# -lt 1 ]] && echo "Usage: twenty meta <query>" >&2 && exit 1
    api_call "/metadata" "$(jq -nc --arg q "$1" '{query: $q}')" | jq .
    ;;

  rest)
    [[ $# -lt 2 ]] && echo "Usage: twenty rest <METHOD> <path> [json]" >&2 && exit 1
    rest_call "$1" "$2" "${3:-}" | jq .
    ;;

  objects)
    raw=$(api_call "/metadata" '{"query":"{ objects(paging:{first:100}) { edges { node { id nameSingular labelSingular isCustom } } } }"}')
    if (( JSON_OUT )); then
      echo "$raw" | jq .
    else
      echo "$raw" \
        | jq -r '.data.objects.edges[].node | "\(.nameSingular)\t\(.id)\t\(.isCustom)"' \
        | column -t -s $'\t'
    fi
    ;;

  fields)
    [[ $# -lt 1 ]] && echo "Usage: twenty fields <objectNameSingular>" >&2 && exit 1
    obj_name="$1"
    # REST /rest/metadata/objects returns all fields inline (no pagination cap),
    # unlike the nested GraphQL `objects { fields { edges } }` which silently caps at ~7.
    result=$(rest_call GET "/rest/metadata/objects")
    # Fall back to the metadata GraphQL API when REST fails. REST
    # /rest/metadata/objects intermittently 500s with "No data sources found"
    # on some server versions while GraphQL /metadata stays healthy — don't let
    # that block a field lookup. Normalize the GraphQL shape to the REST shape
    # (.data.objects[] with .nameSingular and .fields[]) so the printers below
    # are source-agnostic.
    if ! echo "$result" | jq -e '.data.objects' >/dev/null 2>&1; then
      # Two-step: the top-level objects list is uncapped (resolve nameSingular ->
      # id), but the NESTED objects{fields} connection silently caps at ~7, so we
      # then query the single object(id){fields} connection which returns them
      # all. Normalize to the REST shape so the printers below stay source-agnostic.
      objs_raw=$(api_call "/metadata" '{"query":"{ objects(paging:{first:200}) { edges { node { id nameSingular } } } }"}')
      obj_id=$(echo "$objs_raw" | jq -r --arg obj "$obj_name" '.data.objects.edges[].node | select(.nameSingular==$obj) | .id' 2>/dev/null)
      if [[ -z "$obj_id" || "$obj_id" == "null" ]]; then
        echo "Error fetching object '$obj_name' (REST failed, GraphQL metadata had no match):" >&2
        echo "REST:" >&2; echo "$result" | jq . >&2 2>/dev/null || echo "$result" >&2
        echo "GraphQL objects:" >&2; echo "$objs_raw" | jq . >&2 2>/dev/null || echo "$objs_raw" >&2
        exit 1
      fi
      fields_q=$(jq -nc --arg id "$obj_id" '{query: ("{ object(id:\"" + $id + "\"){ nameSingular fields(paging:{first:200}) { edges { node { id name type isCustom isActive } } } } }")}')
      fields_raw=$(api_call "/metadata" "$fields_q")
      if echo "$fields_raw" | jq -e '.data.object.fields.edges' >/dev/null 2>&1; then
        result=$(echo "$fields_raw" | jq '{data:{objects:[{nameSingular:.data.object.nameSingular, fields:[.data.object.fields.edges[].node]}]}}')
      else
        echo "Error fetching fields for '$obj_name' (REST and GraphQL metadata both failed):" >&2
        echo "REST:" >&2; echo "$result" | jq . >&2 2>/dev/null || echo "$result" >&2
        echo "GraphQL fields:" >&2; echo "$fields_raw" | jq . >&2 2>/dev/null || echo "$fields_raw" >&2
        exit 1
      fi
    fi
    # Check the object exists before printing (so unknown names fail loudly)
    found=$(echo "$result" | jq -r --arg obj "$obj_name" \
      '[.data.objects[] | select(.nameSingular == $obj)] | length')
    if [[ "$found" -eq 0 ]]; then
      echo "Error: object '$obj_name' not found. Run 'twenty objects' to list available objects." >&2
      exit 1
    fi
    if (( JSON_OUT )); then
      echo "$result" | jq --arg obj "$obj_name" \
        '.data.objects[] | select(.nameSingular == $obj) | .fields'
    else
      echo "$result" | jq -r --arg obj "$obj_name" \
        '.data.objects[] | select(.nameSingular == $obj) | .fields[] | "\(.name)\t\(.type)\t\(.isCustom)\t\(.id)"' \
        | column -t -s $'\t'
    fi
    ;;

  field-create)
    [[ $# -lt 4 ]] && echo "Usage: twenty field-create <objectMetadataId> <name> <label> <type> [json-extras]" >&2 && exit 1
    obj_id="$1"
    fname="$2"
    flabel="$3"
    ftype="$4"
    extras="${5:-}"

    # Build the mutation payload entirely via jq — user-provided label/name can
    # contain ", \, $, newlines, anything, and it all survives cleanly because
    # we never string-interpolate into the GraphQL source. `type` is enum so it
    # stays inline in the query text (GraphQL enums aren't strings); the risky
    # values all travel as a $field variable.
    payload=$(jq -nc \
      --arg objectMetadataId "$obj_id" \
      --arg name "$fname" \
      --arg label "$flabel" \
      --arg type "$ftype" \
      --argjson extras "${extras:-{\}}" \
      '{
        query: "mutation CreateField($field: CreateFieldInput!) { createOneField(input: { field: $field }) { id name label type } }",
        variables: {
          field: ({
            objectMetadataId: $objectMetadataId,
            type: $type,
            name: $name,
            label: $label,
            isNullable: true
          } + $extras)
        }
      }')

    if (( DRY_RUN )); then
      echo "$payload" | jq .
    else
      api_call "/metadata" "$payload" | jq .
    fi
    ;;

  doctor)
    # Detect (and with --fix, repair) v2-migration schema gaps that crash the
    # frontend on self-hosted instances upgraded across versions (esp. via :latest):
    #   1. NULL applicationId on core metadata rows -> FlatEntityMapsException
    #      ("Application with id null not found ...", surfaced as "An error occurred").
    #   2. Empty core.navigationMenuItem -> blank sidebar (no objects/favorites).
    # Reads/writes the DB directly via SSH+psql (the metadata GraphQL API can't
    # backfill applicationId). Standard app = core.application name 'Twenty Standard'.
    do_fix=0; [[ "${1:-}" == "--fix" ]] && do_fix=1

    std_app=$(printf "select id from core.application where \"workspaceId\"='%s' and name='Twenty Standard' limit 1;" "$TWENTY_WORKSPACE_ID" | pg_exec | tr -d '[:space:]')
    if [[ -z "$std_app" ]]; then
      echo "twenty doctor: could not resolve the 'Twenty Standard' application id (check TWENTY_PG_CONTAINER / workspace)." >&2
      exit 1
    fi
    echo "Twenty Standard application: $std_app"

    echo "== null applicationId across core metadata (workspace-scoped where applicable) =="
    null_report=$(printf "%s" "do \$do\$
declare r record; n bigint; found bool := false;
begin
  for r in select table_name from information_schema.columns
           where table_schema='core' and column_name='applicationId' order by table_name loop
    execute format('select count(*) from core.%I where \"applicationId\" is null', r.table_name) into n;
    if n > 0 then raise notice '%|%', r.table_name, n; found := true; end if;
  end loop;
  if not found then raise notice 'OK|0'; end if;
end \$do\$;" | pg_exec 2>&1 | sed 's/^NOTICE: *//;s/^psql.*NOTICE: *//' | grep -E '\|[0-9]+$' || true)
    echo "$null_report" | awk -F'|' 'NF==2{printf "  %-28s %s null\n",$1,$2}'

    navcount=$(printf "select count(*) from core.\"navigationMenuItem\" where \"workspaceId\"='%s';" "$TWENTY_WORKSPACE_ID" | pg_exec | tr -d '[:space:]')
    echo "== navigationMenuItem rows: ${navcount} ${navcount:+$([[ "$navcount" == 0 ]] && echo '(EMPTY -> blank sidebar; needs seeding)')}"

    if (( do_fix == 0 )); then
      echo
      echo "Run 'twenty doctor --fix' to backfill NULL applicationId -> Twenty Standard."
      echo "(navigationMenuItem seeding is not auto-fixed — it needs the standard menu seed; see memory twenty-nav-menu-fix.)"
      exit 0
    fi

    echo "== --fix: backfilling NULL applicationId -> $std_app =="
    printf "%s" "do \$do\$
declare r record; n bigint;
begin
  for r in select table_name from information_schema.columns
           where table_schema='core' and column_name='applicationId'
           and table_name <> 'connectedAccount'  -- messaging account, not render metadata; leave for manual review
           order by table_name loop
    execute format('update core.%I set \"applicationId\"=%L where \"applicationId\" is null', r.table_name, '$std_app');
    get diagnostics n = row_count;
    if n > 0 then raise notice 'fixed %|%', r.table_name, n; end if;
  end loop;
end \$do\$;" | pg_exec 2>&1 | sed 's/^NOTICE: *//' | grep -E 'fixed ' | sed 's/^fixed /  fixed /;s/|/ = /' || echo "  (nothing to fix)"
    echo
    echo "Done. Restart the Twenty server so the flat-entity cache rebuilds:"
    echo "  ssh $TWENTY_SSH_HOST 'docker restart $TWENTY_CONTAINER'"
    ;;

  person)
    sub="${1:-}"; shift || true
    case "$sub" in
      get)
        if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -lt 1 ]]; then
          cat <<'EOF'
Usage: twenty person get <email|phone|name> [--json]
  Looks up a person by primaryEmail (exact), then primaryPhoneNumber (exact),
  then name (ilike on first OR last). First match wins. Exit 1 if none.
EOF
          [[ $# -lt 1 ]] && exit 1 || exit 0
        fi
        node=$(person_lookup "$1")
        if [[ -z "$node" ]]; then
          echo "No person found for: $1" >&2
          exit 1
        fi
        if (( JSON_OUT )); then
          echo "$node" | jq .
        else
          echo "$node" | jq -r '"id:       \(.id)\nname:     \(.name.firstName) \(.name.lastName)\nemail:    \(.emails.primaryEmail // "")\nphone:    \(.phones.primaryPhoneNumber // "")\ncity:     \(.city // "")\njobTitle: \(.jobTitle // "")\nsource:   \(.source // "")\ngroup:    \(.group // "")\ntenant:   \(.pharmiaTenant // "")"'
        fi
        ;;
      upsert)
        first=""; last=""; email=""; phone=""; city=""; jobTitle=""; source=""; tenant=""; group=""; group_set=0; pharmiaUserId=""; outreachStatus=""
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --first)     first="$2"; shift 2 ;;
            --last)      last="$2"; shift 2 ;;
            --email)     email="$2"; shift 2 ;;
            --phone)     phone="$2"; shift 2 ;;
            --city)      city="$2"; shift 2 ;;
            --job-title) jobTitle="$2"; shift 2 ;;
            --source)    source="$2"; shift 2 ;;
            --outreach-status) outreachStatus="$2"; shift 2 ;;
            --tenant)    tenant="$2"; shift 2 ;;
            --pharmia-user-id) pharmiaUserId="$2"; shift 2 ;;
            --group)     group="$2"; group_set=1; shift 2 ;;
            -h|--help)
              cat <<'EOF'
Usage: twenty person upsert --email <email> [flags]
  Create-or-update a person keyed on primaryEmail (looks up first; updates if
  found, else creates). Prints the id and whether it was created or updated.

  --first <name>        firstName
  --last <name>         lastName
  --email <email>       primaryEmail  (REQUIRED — the upsert key)
  --phone <E.164>       e.g. +15145551234  (split into number/+1/CA)
  --city <city>
  --job-title <title>
  --source <enum>       PHARMIA_SIGNUP INBOUND_MEETING REFERRAL COLD SOCIAL EVENT PARTNER_REFERRAL
  --outreach-status <enum>  NOT_CONTACTED CONTACTED INTERESTED MEETING_BOOKED IN_DISCUSSION CONVERTED NOT_INTERESTED
  --tenant <slug>       pharmiaTenant
  --pharmia-user-id <id>  Pharmia better-auth user id (ba_user.id) — the CRM<->app
                        link. Set it when a person signs up to Pharmia/Atlas so
                        the "Atlas user" segments work. (Backfilled daily by
                        pharmia-twenty-atlas-sync via email if not set here.)
  --group <enum|null>   PHARMACIST_OWNER PHARMACIST VC INFLUENCER MENTOR CLIENT SALES PARTNER (or 'null' to clear)
EOF
              exit 0 ;;
            *) echo "person upsert: unknown flag '$1'" >&2; exit 1 ;;
          esac
        done
        [[ -z "$email" ]] && { echo "person upsert: --email is required (it is the upsert key)" >&2; exit 1; }

        # Build the data object incrementally so we only send provided fields.
        # name is a FULL_NAME composite; phones split a leading-+1 E.164 into
        # number + callingCode + countryCode (we only handle +1/CA explicitly,
        # everything else keeps the full string as the number with no CC guess).
        data=$(jq -nc '{}')
        if [[ -n "$first" || -n "$last" ]]; then
          data=$(echo "$data" | jq --arg f "$first" --arg l "$last" '. + {name: {firstName:$f, lastName:$l}}')
        fi
        data=$(echo "$data" | jq --arg e "$email" '. + {emails: {primaryEmail:$e}}')
        if [[ -n "$phone" ]]; then
          if [[ "$phone" =~ ^\+1[0-9]{10}$ ]]; then
            num="${phone#+1}"
            data=$(echo "$data" | jq --arg n "$num" '. + {phones: {primaryPhoneNumber:$n, primaryPhoneCallingCode:"+1", primaryPhoneCountryCode:"CA"}}')
          else
            data=$(echo "$data" | jq --arg n "$phone" '. + {phones: {primaryPhoneNumber:$n}}')
          fi
        fi
        [[ -n "$city" ]]     && data=$(echo "$data" | jq --arg v "$city" '. + {city:$v}')
        [[ -n "$jobTitle" ]] && data=$(echo "$data" | jq --arg v "$jobTitle" '. + {jobTitle:$v}')
        [[ -n "$tenant" ]]   && data=$(echo "$data" | jq --arg v "$tenant" '. + {pharmiaTenant:$v}')
        [[ -n "$pharmiaUserId" ]] && data=$(echo "$data" | jq --arg v "$pharmiaUserId" '. + {pharmiaUserId:$v}')

        # GraphQL can't merge a variable object with inline enum fields, so fold
        # the SELECT enums into $data as JSON values — the server accepts
        # enum-as-string for SELECT fields (verified). `enum_fields` (inline) is
        # therefore unused; kept the JSON path as the single source of truth.
        [[ -n "$source" ]] && data=$(echo "$data" | jq --arg v "$source" '. + {source:$v}')
        [[ -n "$outreachStatus" ]] && data=$(echo "$data" | jq --arg v "$outreachStatus" '. + {outreachStatus:$v}')
        if (( group_set )); then
          if [[ "$group" == "null" ]]; then data=$(echo "$data" | jq '. + {group:null}')
          else data=$(echo "$data" | jq --arg v "$group" '. + {group:$v}'); fi
        fi

        existing=$(person_id_by_email "$email")
        if [[ -n "$existing" ]]; then
          out=$(data_gql 'mutation($id: ID!, $data: PersonUpdateInput!) { updatePerson(id: $id, data: $data) { id } }' "$(jq -nc --arg id "$existing" --argjson d "$data" '{id:$id, data:$d}')")
          (( DRY_RUN )) && { echo "$out"; exit 0; }
          echo "updated $(echo "$out" | jq -r '.data.updatePerson.id')"
        else
          out=$(data_gql 'mutation($data: PersonCreateInput!) { createPerson(data: $data) { id } }' "$(jq -nc --argjson d "$data" '{data:$d}')")
          (( DRY_RUN )) && { echo "$out"; exit 0; }
          echo "created $(echo "$out" | jq -r '.data.createPerson.id')"
        fi
        ;;
      -h|--help|"")
        echo "Usage: twenty person <get|upsert> ...  (run 'twenty person <sub> --help')" >&2
        [[ "$sub" == "-h" || "$sub" == "--help" ]] && exit 0 || exit 1 ;;
      *) echo "person: unknown subcommand '$sub'" >&2; exit 1 ;;
    esac
    ;;

  company)
    sub="${1:-}"; shift || true
    case "$sub" in
      upsert)
        name=""; employees=""; domain=""; city=""; icp=""; rxPerDay=""
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --name)       name="$2"; shift 2 ;;
            --employees)  employees="$2"; shift 2 ;;
            --domain)     domain="$2"; shift 2 ;;
            --city)       city="$2"; shift 2 ;;
            --rx-per-day) rxPerDay="$2"; shift 2 ;;
            --icp)        icp="true"; shift ;;
            -h|--help)
              cat <<'EOF'
Usage: twenty company upsert --name <name> [flags]
  Create-or-update a company keyed on exact name.
  --name <name>        REQUIRED — the upsert key
  --employees <n>      headcount
  --domain <host>      primary domain (e.g. pharmacie.qc.ca)
  --city <city>        sets address.addressCity
  --rx-per-day <n>     custom field rxPerDay
  --icp                mark as idealCustomerProfile
EOF
              exit 0 ;;
            *) echo "company upsert: unknown flag '$1'" >&2; exit 1 ;;
          esac
        done
        [[ -z "$name" ]] && { echo "company upsert: --name is required (it is the upsert key)" >&2; exit 1; }
        data=$(jq -nc --arg n "$name" '{name:$n}')
        [[ -n "$employees" ]] && data=$(echo "$data" | jq --argjson v "$employees" '. + {employees:$v}')
        [[ -n "$rxPerDay" ]]  && data=$(echo "$data" | jq --argjson v "$rxPerDay" '. + {rxPerDay:$v}')
        [[ -n "$domain" ]]    && data=$(echo "$data" | jq --arg v "$domain" '. + {domainName: {primaryLinkUrl:$v}}')
        [[ -n "$city" ]]      && data=$(echo "$data" | jq --arg v "$city" '. + {address: {addressCity:$v}}')
        [[ -n "$icp" ]]       && data=$(echo "$data" | jq '. + {idealCustomerProfile:true}')

        existing=$(company_id_by_name "$name")
        if [[ -n "$existing" ]]; then
          out=$(data_gql 'mutation($id: ID!, $data: CompanyUpdateInput!) { updateCompany(id: $id, data: $data) { id } }' "$(jq -nc --arg id "$existing" --argjson d "$data" '{id:$id, data:$d}')")
          (( DRY_RUN )) && { echo "$out"; exit 0; }
          echo "updated $(echo "$out" | jq -r '.data.updateCompany.id')"
        else
          out=$(data_gql 'mutation($data: CompanyCreateInput!) { createCompany(data: $data) { id } }' "$(jq -nc --argjson d "$data" '{data:$d}')")
          (( DRY_RUN )) && { echo "$out"; exit 0; }
          echo "created $(echo "$out" | jq -r '.data.createCompany.id')"
        fi
        ;;
      -h|--help|"")
        echo "Usage: twenty company upsert ...  (run 'twenty company upsert --help')" >&2
        [[ "$sub" == "-h" || "$sub" == "--help" ]] && exit 0 || exit 1 ;;
      *) echo "company: unknown subcommand '$sub'" >&2; exit 1 ;;
    esac
    ;;

  opportunity)
    sub="${1:-}"; shift || true
    case "$sub" in
      get)
        person=""; all_stages=0
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --person) person="$2"; shift 2 ;;
            --all)    all_stages=1; shift ;;
            -h|--help)
              cat <<'EOF'
Usage: twenty opportunity get --person <personId> [--all] [--json]
  Find opportunities where the person is the point of contact. By default only
  ACTIVE stages (NEW SCREENING MEETING PROPOSAL) — use --all to include
  DONE/CLIENT/LATER. Use this to dedupe before 'opportunity create'.
EOF
              exit 0 ;;
            *) echo "opportunity get: unknown flag '$1'" >&2; exit 1 ;;
          esac
        done
        [[ -z "$person" ]] && { echo "opportunity get: --person <id> is required" >&2; exit 1; }
        if (( all_stages )); then
          out=$(data_gql 'query($p: UUID!) { opportunities(filter: { pointOfContactId: { eq: $p } }, first: 20) { edges { node { id name stage closeDate } } } }' "$(jq -nc --arg p "$person" '{p:$p}')")
        else
          out=$(data_gql 'query($p: UUID!) { opportunities(filter: { pointOfContactId: { eq: $p }, stage: { in: [NEW, SCREENING, MEETING, PROPOSAL] } }, first: 20) { edges { node { id name stage closeDate } } } }' "$(jq -nc --arg p "$person" '{p:$p}')")
        fi
        if (( JSON_OUT )); then
          echo "$out" | jq '[.data.opportunities.edges[].node]'
        else
          echo "$out" | jq -r '.data.opportunities.edges[].node | "\(.id)\t\(.stage)\t\(.name)"' | column -t -s $'\t'
        fi
        ;;
      create)
        name=""; stage=""; closeDate=""; person=""; company=""
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --name)       name="$2"; shift 2 ;;
            --stage)      stage="$2"; shift 2 ;;
            --close-date) closeDate="$2"; shift 2 ;;
            --person)     person="$2"; shift 2 ;;
            --company)    company="$2"; shift 2 ;;
            -h|--help)
              cat <<'EOF'
Usage: twenty opportunity create --name <name> [flags]
  --name <name>         REQUIRED
  --stage <enum>        NEW SCREENING MEETING PROPOSAL DONE CLIENT LATER (default NEW)
  --close-date <ISO>    e.g. 2026-12-31 (coerced to ISO datetime)
  --person <personId>   sets pointOfContactId
  --company <companyId> sets companyId
EOF
              exit 0 ;;
            *) echo "opportunity create: unknown flag '$1'" >&2; exit 1 ;;
          esac
        done
        [[ -z "$name" ]] && { echo "opportunity create: --name is required" >&2; exit 1; }
        [[ -z "$stage" ]] && stage="NEW"
        data=$(jq -nc --arg n "$name" --arg s "$stage" '{name:$n, stage:$s}')
        if [[ -n "$closeDate" ]]; then
          [[ "$closeDate" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && closeDate="${closeDate}T00:00:00.000Z"
          data=$(echo "$data" | jq --arg v "$closeDate" '. + {closeDate:$v}')
        fi
        [[ -n "$person" ]]  && data=$(echo "$data" | jq --arg v "$person" '. + {pointOfContactId:$v}')
        [[ -n "$company" ]] && data=$(echo "$data" | jq --arg v "$company" '. + {companyId:$v}')
        out=$(data_gql 'mutation($data: OpportunityCreateInput!) { createOpportunity(data: $data) { id name stage } }' "$(jq -nc --argjson d "$data" '{data:$d}')")
        (( DRY_RUN )) && { echo "$out"; exit 0; }
        echo "$out" | jq -r '.data.createOpportunity | "created \(.id)  stage=\(.stage)  name=\(.name)"'
        ;;
      update)
        id="${1:-}"; shift || true
        [[ -z "$id" || "$id" == -* ]] && { echo "Usage: twenty opportunity update <id> [--stage <enum>] [--close-date <ISO>]" >&2; exit 1; }
        stage=""; closeDate=""
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --stage)      stage="$2"; shift 2 ;;
            --close-date) closeDate="$2"; shift 2 ;;
            -h|--help) echo "Usage: twenty opportunity update <id> [--stage <enum>] [--close-date <ISO>]"; exit 0 ;;
            *) echo "opportunity update: unknown flag '$1'" >&2; exit 1 ;;
          esac
        done
        data=$(jq -nc '{}')
        [[ -n "$stage" ]] && data=$(echo "$data" | jq --arg v "$stage" '. + {stage:$v}')
        if [[ -n "$closeDate" ]]; then
          [[ "$closeDate" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && closeDate="${closeDate}T00:00:00.000Z"
          data=$(echo "$data" | jq --arg v "$closeDate" '. + {closeDate:$v}')
        fi
        [[ "$data" == "{}" ]] && { echo "opportunity update: nothing to update (pass --stage and/or --close-date)" >&2; exit 1; }
        out=$(data_gql 'mutation($id: ID!, $data: OpportunityUpdateInput!) { updateOpportunity(id: $id, data: $data) { id stage closeDate } }' "$(jq -nc --arg id "$id" --argjson d "$data" '{id:$id, data:$d}')")
        (( DRY_RUN )) && { echo "$out"; exit 0; }
        echo "$out" | jq -r '.data.updateOpportunity | "updated \(.id)  stage=\(.stage)  closeDate=\(.closeDate)"'
        ;;
      -h|--help|"")
        echo "Usage: twenty opportunity <get|create|update> ...  (run '... --help')" >&2
        [[ "$sub" == "-h" || "$sub" == "--help" ]] && exit 0 || exit 1 ;;
      *) echo "opportunity: unknown subcommand '$sub'" >&2; exit 1 ;;
    esac
    ;;

  note)
    sub="${1:-}"; shift || true
    case "$sub" in
      add)
        title=""; md=""; mdfile=""; links=()
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --title)   title="$2"; shift 2 ;;
            --md)      md="$2"; shift 2 ;;
            --md-file) mdfile="$2"; shift 2 ;;
            --link)    links+=("$2"); shift 2 ;;
            -h|--help)
              cat <<'EOF'
Usage: twenty note add --title <title> (--md <markdown> | --md-file <path>) [--link <type>:<id> ...]
  Creates a note (bodyV2 markdown) AND links it to records in one call.
  --title <title>           REQUIRED
  --md <markdown>           note body as markdown (or use --md-file)
  --md-file <path>          read markdown body from a file
  --link person:<id>        repeatable; also opportunity:<id>, company:<id>
EOF
              exit 0 ;;
            *) echo "note add: unknown flag '$1'" >&2; exit 1 ;;
          esac
        done
        [[ -z "$title" ]] && { echo "note add: --title is required" >&2; exit 1; }
        if [[ -n "$mdfile" ]]; then
          [[ -f "$mdfile" ]] || { echo "note add: --md-file not found: $mdfile" >&2; exit 1; }
          md=$(cat "$mdfile")
        fi
        out=$(data_gql 'mutation($data: NoteCreateInput!) { createNote(data: $data) { id } }' "$(jq -nc --arg t "$title" --arg m "$md" '{data:{title:$t, bodyV2:{markdown:$m}}}')")
        if (( DRY_RUN )); then echo "$out"; exit 0; fi
        noteId=$(echo "$out" | jq -r '.data.createNote.id')
        echo "created note $noteId"
        for link in "${links[@]}"; do
          ltype="${link%%:*}"; lid="${link##*:}"
          case "$ltype" in
            person)      field="personId" ;;
            opportunity) field="opportunityId" ;;
            company)     field="companyId" ;;
            *) echo "note add: unknown link type '$ltype' (use person|opportunity|company)" >&2; exit 1 ;;
          esac
          lout=$(data_gql 'mutation($data: NoteTargetCreateInput!) { createNoteTarget(data: $data) { id } }' "$(jq -nc --arg n "$noteId" --arg t "$lid" --arg f "$field" '{data:({noteId:$n} + {($f):$t})}')")
          echo "  linked $ltype $lid -> noteTarget $(echo "$lout" | jq -r '.data.createNoteTarget.id')"
        done
        ;;
      -h|--help|"")
        echo "Usage: twenty note add ...  (run 'twenty note add --help')" >&2
        [[ "$sub" == "-h" || "$sub" == "--help" ]] && exit 0 || exit 1 ;;
      *) echo "note: unknown subcommand '$sub'" >&2; exit 1 ;;
    esac
    ;;

  task)
    sub="${1:-}"; shift || true
    case "$sub" in
      create)
        title=""; body=""; due=""; status=""; links=()
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --title)  title="$2"; shift 2 ;;
            --body)   body="$2"; shift 2 ;;
            --due)    due="$2"; shift 2 ;;
            --status) status="$2"; shift 2 ;;
            --link)   links+=("$2"); shift 2 ;;
            -h|--help)
              cat <<'EOF'
Usage: twenty task create --title <title> [flags] [--link <type>:<id> ...]
  --title <title>      REQUIRED
  --body <markdown>    task body (bodyV2 markdown)
  --due <ISO>          due date, e.g. 2026-07-01 (coerced to ISO datetime)
  --status <enum>      TODO IN_PROGRESS PLANNED DONE WONT_DO WAITING LATER (default TODO)
  --link person:<id>   repeatable; also opportunity:<id>, company:<id>
EOF
              exit 0 ;;
            *) echo "task create: unknown flag '$1'" >&2; exit 1 ;;
          esac
        done
        [[ -z "$title" ]] && { echo "task create: --title is required" >&2; exit 1; }
        [[ -z "$status" ]] && status="TODO"
        data=$(jq -nc --arg t "$title" --arg s "$status" '{title:$t, status:$s}')
        [[ -n "$body" ]] && data=$(echo "$data" | jq --arg v "$body" '. + {bodyV2:{markdown:$v}}')
        if [[ -n "$due" ]]; then
          [[ "$due" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && due="${due}T00:00:00.000Z"
          data=$(echo "$data" | jq --arg v "$due" '. + {dueAt:$v}')
        fi
        out=$(data_gql 'mutation($data: TaskCreateInput!) { createTask(data: $data) { id } }' "$(jq -nc --argjson d "$data" '{data:$d}')")
        if (( DRY_RUN )); then echo "$out"; exit 0; fi
        taskId=$(echo "$out" | jq -r '.data.createTask.id')
        echo "created task $taskId"
        for link in "${links[@]}"; do
          ltype="${link%%:*}"; lid="${link##*:}"
          case "$ltype" in
            person)      field="personId" ;;
            opportunity) field="opportunityId" ;;
            company)     field="companyId" ;;
            *) echo "task create: unknown link type '$ltype' (use person|opportunity|company)" >&2; exit 1 ;;
          esac
          lout=$(data_gql 'mutation($data: TaskTargetCreateInput!) { createTaskTarget(data: $data) { id } }' "$(jq -nc --arg tk "$taskId" --arg t "$lid" --arg f "$field" '{data:({taskId:$tk} + {($f):$t})}')")
          echo "  linked $ltype $lid -> taskTarget $(echo "$lout" | jq -r '.data.createTaskTarget.id')"
        done
        ;;
      -h|--help|"")
        echo "Usage: twenty task create ...  (run 'twenty task create --help')" >&2
        [[ "$sub" == "-h" || "$sub" == "--help" ]] && exit 0 || exit 1 ;;
      *) echo "task: unknown subcommand '$sub'" >&2; exit 1 ;;
    esac
    ;;

  *)
    echo "Unknown command: $CMD" >&2
    usage 1
    ;;
esac
