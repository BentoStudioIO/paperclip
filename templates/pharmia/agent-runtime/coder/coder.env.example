# Coder control-plane runtime env — PLACEHOLDER TEMPLATE (commit this, never the real file).
#
# On the box, the REAL file lives at /etc/coder/coder.env, root-owned, chmod 600.
# Fill the placeholders there. NEVER commit real secret values.
#
#   sudo install -d -m 700 /etc/coder
#   sudo cp coder.env.example /etc/coder/coder.env
#   sudo chmod 600 /etc/coder/coder.env
#   # then edit /etc/coder/coder.env and fill the <...> placeholders

# Public access URL (TLS terminated by host Caddy).
CODER_ACCESS_URL=https://code.bentostudio.io

# --- Postgres (internal to the compose network) ---
CODER_PG_USER=coder
CODER_PG_PASSWORD=<GENERATE_A_STRONG_RANDOM_PASSWORD>
CODER_PG_DB=coder

# Host docker group gid (getent group docker → 985 on the agents VPS).
DOCKER_GROUP_ID=985

# --- PocketID OIDC ---
# Issuer = the PocketID base URL ($POCKETID_URL). Discovery at <issuer>/.well-known/openid-configuration.
CODER_OIDC_ISSUER_URL=https://auth.bentostudio.io
# Created via the PocketID API (name "Coder", redirect https://code.bentostudio.io/api/v2/users/oidc/callback, PKCE).
CODER_OIDC_CLIENT_ID=<POCKETID_OIDC_CLIENT_ID>
CODER_OIDC_CLIENT_SECRET=<POCKETID_OIDC_CLIENT_SECRET>
