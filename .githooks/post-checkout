#!/bin/sh
# Re-sync Paperclip agents on branch checkout (args: prevHEAD newHEAD branchFlag).
# Only the PRIMARY worktree owns the ~/.local/bin CLI symlinks and the ~/.claude
# sync. In a linked worktree the git-dir lives under .git/worktrees/<name>; bail
# here so `git worktree add` never re-points the canonical symlinks into a
# throwaway worktree (deleting it would dangle pg/loki/threads/ol …).
case "$(git rev-parse --absolute-git-dir 2>/dev/null)" in
  */worktrees/*) exit 0 ;;
esac
[ "$3" = "1" ] || exit 0   # only on branch checkouts, not file checkouts
sh "$(git rev-parse --show-toplevel)/templates/pharmia/cli/install.sh" >/dev/null 2>&1 || true
command -v node >/dev/null 2>&1 || exit 0
node "$(git rev-parse --show-toplevel)/scripts/sync-claude-agents.mjs" || true
node "$(git rev-parse --show-toplevel)/scripts/sync-claude-skills.mjs" || true
node "$(git rev-parse --show-toplevel)/scripts/sync-claude-rules.mjs" || true
