#!/bin/sh
# Auto-sync Paperclip agent definitions into ~/.claude/agents after pull/merge.
# Paperclip is the source of truth; generated files are tagged `source: paperclip`.
# CLI toolkit (sh, no node needed): symlink templates/pharmia/cli/bin/* into ~/.local/bin.
# Only the PRIMARY worktree owns the ~/.local/bin symlinks + ~/.claude sync — bail
# in a linked worktree (git-dir under .git/worktrees/<name>) so a worktree merge
# never re-points the canonical CLI symlinks into a transient checkout.
case "$(git rev-parse --absolute-git-dir 2>/dev/null)" in
  */worktrees/*) exit 0 ;;
esac
TOP="$(git rev-parse --show-toplevel)"
sh "$TOP/templates/pharmia/cli/install.sh" >/dev/null 2>&1 || true
command -v node >/dev/null 2>&1 || exit 0

# Agents VPS: the ONE canonical harness is the `agent` runtime's (/home/agent/.claude).
# Refresh it directly and SKIP the operator-self render — single source of truth, no
# parallel ubuntu copy to drift. (Gated on the paperclip agent-runtime marker so this
# branch never fires on a normal dev workstation.)
if id agent >/dev/null 2>&1 && [ -d /home/agent/.claude ]; then
  sh "$TOP/templates/pharmia/agent-runtime/sync-agent-harness.sh" || true
  exit 0
fi

# Every other machine (dev workstations): sync the pulling user's own ~/.claude.
node "$TOP/scripts/sync-claude-agents.mjs" || true
node "$TOP/scripts/sync-claude-skills.mjs" || true
node "$TOP/scripts/sync-claude-rules.mjs" || true
