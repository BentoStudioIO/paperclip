#!/usr/bin/env bash
set -euo pipefail

# Google Calendar CLI — Bento Studio
# Config: ~/.config/gcal/config (CLIENT_ID, CLIENT_SECRET, REFRESH_TOKEN, DEFAULT_CALENDAR, TIMEZONE)

usage() {
  local code="${1:-0}"
  cat <<'EOF'
Usage: gcal <command> [args]

Commands:
  auth                                        Force re-authenticate (new OAuth flow)
  list [--from DATE] [--to DATE]              List events (default: next 7 days)
  find <query> [--from DATE] [--to DATE]      Full-text search over summary/description/attendees/location
  get|show <event-id>                         Get event details
  freebusy <date> [--time HH:MM-HH:MM]        Check busy slots (default 09:00-18:00)
  create <title> <date> <time> [opts]         Create an event
  update <event-id> [opts]                    Update an event
  delete|rm <event-id> [--instance|--series]  Delete an event

Options for create:
  --duration MINUTES    Duration in minutes (default: 30)
  --end-time HH:MM      Explicit end time (overrides --duration)
  --emails a@b,c@d      Comma-separated attendee emails
  --desc TEXT           Event description
  --meet                Add Google Meet link
  --cal CALENDAR_ID     Override default calendar
  --tz TIMEZONE         Override default timezone (e.g. America/Toronto)
  --no-defaults         Skip DEFAULT_ATTENDEES merge
  --force               Create even if conflicts detected
  --dry-run             Print the request body, do not POST

Options for update:
  --title TEXT          New title
  --date DATE           New date (shortcuts supported)
  --time HH:MM          New start time
  --duration MINUTES    New duration
  --end-time HH:MM      Explicit new end time
  --emails a@b,c@d      Replace attendees
  --desc TEXT           New description
  --meet                Add Meet link if missing
  --cal CALENDAR_ID     Override default calendar
  --tz TIMEZONE         Override default timezone
  --instance            Edit only this occurrence (for recurring events)
  --series              Edit the whole recurring series

Options for delete:
  --instance            Delete only this occurrence (for recurring events)
  --series              Delete the whole recurring series

Global:
  --json                Emit raw API JSON (list/find/get/create/update)

Date formats: YYYY-MM-DD, today, tomorrow, yesterday, +Nd, -Nd,
              this-week, next-week, this-month, next-month
Time format:  HH:MM

Examples:
  gcal list
  gcal list --from today --to +7d
  gcal list --json | jq '.items[].summary'
  gcal find "standup"
  gcal find "demo" --from this-week --to next-week
  gcal freebusy today --time 14:00-15:00
  gcal create "Meeting TherAppX" 2026-03-31 09:00
  gcal create "Demo" tomorrow 14:00 --duration 60 --emails a@b.com --meet
  gcal update abc123 --title "New title" --date 2026-04-02 --time 10:00
  gcal update abc123 --instance --time 11:00
  gcal delete abc123 --series
EOF
  exit "$code"
}

case "${1:-}" in
  -h|--help|help)
    usage 0
    ;;
esac

[[ $# -lt 1 ]] && usage 1

CONFIG="${HOME}/.config/gcal/config"
# Load config file if present; env vars take precedence (set before sourcing so
# any file values only fill in what env hasn't already provided).
if [[ -f "$CONFIG" ]]; then
  _pre_client_id="${GCAL_CLIENT_ID:-}"
  _pre_client_secret="${GCAL_CLIENT_SECRET:-}"
  _pre_refresh_token="${GCAL_REFRESH_TOKEN:-}"
  _pre_default_calendar="${GCAL_DEFAULT_CALENDAR:-}"
  _pre_timezone="${GCAL_TIMEZONE:-}"
  _pre_default_attendees="${GCAL_DEFAULT_ATTENDEES:-}"
  source "$CONFIG"
  # Env vars win over config file
  [[ -n "$_pre_client_id" ]]         && CLIENT_ID="$_pre_client_id"
  [[ -n "$_pre_client_secret" ]]     && CLIENT_SECRET="$_pre_client_secret"
  [[ -n "$_pre_refresh_token" ]]     && REFRESH_TOKEN="$_pre_refresh_token"
  [[ -n "$_pre_default_calendar" ]]  && DEFAULT_CALENDAR="$_pre_default_calendar"
  [[ -n "$_pre_timezone" ]]          && TIMEZONE="$_pre_timezone"
  [[ -n "$_pre_default_attendees" ]] && DEFAULT_ATTENDEES="$_pre_default_attendees"
  unset _pre_client_id _pre_client_secret _pre_refresh_token _pre_default_calendar _pre_timezone _pre_default_attendees
else
  # No config file — load entirely from env vars
  CLIENT_ID="${GCAL_CLIENT_ID:?Set GCAL_CLIENT_ID}"
  CLIENT_SECRET="${GCAL_CLIENT_SECRET:?Set GCAL_CLIENT_SECRET}"
  REFRESH_TOKEN="${GCAL_REFRESH_TOKEN:?Set GCAL_REFRESH_TOKEN}"
  DEFAULT_CALENDAR="${GCAL_DEFAULT_CALENDAR:-}"
  TIMEZONE="${GCAL_TIMEZONE:-America/Toronto}"
  DEFAULT_ATTENDEES="${GCAL_DEFAULT_ATTENDEES:-}"
fi

API="https://www.googleapis.com/calendar/v3"
TOKEN_CACHE="${HOME}/.config/gcal/.token_cache"
OAUTH_PORT=8484
OAUTH_REDIRECT="http://localhost:${OAUTH_PORT}"
SCOPES="https://www.googleapis.com/auth/calendar"

# --- Auth ---

sync_token_from_n8n() {
  # SSH-based n8n sync is not available in container environments.
  return 1
}

refresh_access_token() {
  local response token expires_in error_code
  response=$(curl -sS -X POST "https://oauth2.googleapis.com/token" \
    -d "client_id=${CLIENT_ID}" \
    -d "client_secret=${CLIENT_SECRET}" \
    -d "refresh_token=${REFRESH_TOKEN}" \
    -d "grant_type=refresh_token") || {
    echo "Failed to reach Google OAuth token endpoint" >&2
    return 1
  }
  error_code=$(echo "$response" | jq -r '.error // empty')
  if [[ "$error_code" == "invalid_grant" ]]; then
    return 2
  fi
  token=$(echo "$response" | jq -r '.access_token // empty')
  if [[ -z "$token" ]]; then
    local error_message
    error_message=$(echo "$response" | jq -r '.error_description // .error.message // .error // "Failed to refresh access token"' 2>/dev/null || true)
    [[ -n "$error_message" ]] || error_message="Failed to refresh access token"
    echo "$error_message" >&2
    return 1
  fi
  expires_in=$(echo "$response" | jq -r '.expires_in // 3600')
  local expires_at=$(( $(date +%s) + expires_in - 60 ))
  echo "${token}|${expires_at}" > "$TOKEN_CACHE"
  echo "$token"
}

load_cached_token() {
  [[ -f "$TOKEN_CACHE" ]] || return 1
  local cached
  cached=$(<"$TOKEN_CACHE")
  local token="${cached%%|*}"
  local expires_at="${cached##*|}"
  [[ -z "$token" || -z "$expires_at" ]] && return 1
  local now
  now=$(date +%s)
  (( now < expires_at )) || return 1
  echo "$token"
}

do_oauth_flow() {
  echo "Refresh token expiré. Lancement du OAuth flow..." >&2
  local auth_url="https://accounts.google.com/o/oauth2/v2/auth?client_id=${CLIENT_ID}&redirect_uri=${OAUTH_REDIRECT}&response_type=code&scope=${SCOPES}&access_type=offline&prompt=consent"
  echo "Ouvre ce lien dans ton navigateur :" >&2
  echo "" >&2
  echo "  ${auth_url}" >&2
  echo "" >&2

  if command -v xdg-open &>/dev/null; then
    xdg-open "$auth_url" 2>/dev/null &
  elif command -v open &>/dev/null; then
    open "$auth_url" 2>/dev/null &
  fi

  echo "En attente du callback sur localhost:${OAUTH_PORT}..." >&2
  local code=""
  code=$(python3 -c "
import http.server, urllib.parse, sys, threading

code = [None]

class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        if 'code' in qs:
            code[0] = qs['code'][0]
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b'<h2>OK, tu peux fermer cet onglet.</h2>')
        else:
            self.send_response(400)
            self.end_headers()
            self.wfile.write(b'No code')
        threading.Thread(target=self.server.shutdown).start()
    def log_message(self, *a): pass

s = http.server.HTTPServer(('127.0.0.1', ${OAUTH_PORT}), H)
s.handle_request()
s.handle_request()  # shutdown request
if code[0]:
    print(code[0])
else:
    sys.exit(1)
" 2>/dev/null) || {
    echo "Échec de la récupération du code OAuth" >&2
    return 1
  }

  [[ -z "$code" ]] && { echo "Pas de code reçu" >&2; return 1; }

  local response
  response=$(curl -sS -X POST "https://oauth2.googleapis.com/token" \
    -d "client_id=${CLIENT_ID}" \
    -d "client_secret=${CLIENT_SECRET}" \
    -d "code=${code}" \
    -d "redirect_uri=${OAUTH_REDIRECT}" \
    -d "grant_type=authorization_code") || {
    echo "Échec de l'échange du code" >&2
    return 1
  }

  local token new_refresh expires_in
  token=$(echo "$response" | jq -r '.access_token // empty')
  new_refresh=$(echo "$response" | jq -r '.refresh_token // empty')
  expires_in=$(echo "$response" | jq -r '.expires_in // 3600')

  if [[ -z "$token" ]]; then
    echo "Échec : $(echo "$response" | jq -r '.error_description // .error // "unknown"')" >&2
    return 1
  fi

  if [[ -n "$new_refresh" ]]; then
    sed -i "s|^REFRESH_TOKEN=.*|REFRESH_TOKEN=\"${new_refresh}\"|" "$CONFIG"
    REFRESH_TOKEN="$new_refresh"
    echo "Refresh token mis à jour dans $CONFIG" >&2
  fi

  local expires_at=$(( $(date +%s) + expires_in - 60 ))
  echo "${token}|${expires_at}" > "$TOKEN_CACHE"
  echo "$token"
}

get_token() {
  local token
  token=$(load_cached_token) && { echo "$token"; return 0; }

  token=$(refresh_access_token)
  local rc=$?
  if [[ $rc -eq 0 ]]; then
    echo "$token"
    return 0
  fi

  if [[ $rc -eq 2 ]]; then
    # Try syncing fresh token from n8n before falling back to interactive OAuth
    if sync_token_from_n8n; then
      token=$(refresh_access_token)
      if [[ $? -eq 0 ]]; then
        echo "$token"
        return 0
      fi
    fi
    token=$(do_oauth_flow) || exit 1
    echo "$token"
    return 0
  fi

  exit 1
}

TOKEN=""
auth() {
  [[ -n "$TOKEN" ]] && return
  local token
  token=$(get_token) || exit 1
  TOKEN="$token"
}

gcurl() {
  auth
  local response status body message
  response=$(curl -sS -w $'\n%{http_code}' -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" "$@") || {
    echo "Google Calendar API request failed" >&2
    return 1
  }
  status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  if [[ "$status" =~ ^[0-9]+$ ]] && (( status >= 400 )); then
    message=$(echo "$body" | jq -r '.error.message // .error_description // .error // empty' 2>/dev/null || true)
    [[ -n "$message" ]] || message="Google Calendar API request failed (HTTP $status)"
    echo "$message" >&2
    return 1
  fi
  printf '%s' "$body"
}

# --- Helpers ---

cal_id() {
  echo "${OPT_CAL:-$DEFAULT_CALENDAR}"
}

event_tz() {
  echo "${OPT_TZ:-$TIMEZONE}"
}

# Parse a flexible date expression into YYYY-MM-DD.
# Accepts: YYYY-MM-DD, today, tomorrow, yesterday, +Nd, -Nd,
#          this-week (Monday), next-week (next Monday),
#          this-month (1st), next-month (1st of next month),
#          or anything GNU date -d understands.
parse_date() {
  local input="$1"
  [[ -z "$input" ]] && return 1

  case "$input" in
    today|tomorrow|yesterday)
      date -d "$input" '+%Y-%m-%d'
      return
      ;;
    [+-][0-9]*d)
      local sign="${input:0:1}"
      local n="${input:1:${#input}-2}"
      date -d "${sign}${n} days" '+%Y-%m-%d'
      return
      ;;
    this-week)
      # Monday of current ISO week
      local dow today_d
      dow=$(date '+%u')            # 1=Mon..7=Sun
      date -d "-$(( dow - 1 )) days" '+%Y-%m-%d'
      return
      ;;
    next-week)
      local dow
      dow=$(date '+%u')
      date -d "+$(( 8 - dow )) days" '+%Y-%m-%d'
      return
      ;;
    this-month)
      date '+%Y-%m-01'
      return
      ;;
    next-month)
      date -d "$(date '+%Y-%m-01') +1 month" '+%Y-%m-%d'
      return
      ;;
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9])
      echo "$input"
      return
      ;;
  esac

  # Fallback: hand off to GNU date
  local out
  if out=$(date -d "$input" '+%Y-%m-%d' 2>/dev/null); then
    echo "$out"
    return
  fi
  echo "Invalid date: $input" >&2
  return 1
}

iso_datetime() {
  local date="$1" time="$2"
  echo "${date}T${time}:00"
}

add_minutes() {
  local date="$1" time="$2" mins="$3"
  date -d "${date}T${time}:00 ${mins} minutes" '+%Y-%m-%dT%H:%M:00'
}

attendees_json() {
  local emails="$1"
  local arr="["
  local first=true
  IFS=',' read -ra ADDRS <<< "$emails"
  for addr in "${ADDRS[@]}"; do
    addr=$(echo "$addr" | xargs)
    [[ -z "$addr" ]] && continue
    $first || arr+=","
    arr+="{\"email\":\"${addr}\"}"
    first=false
  done
  arr+="]"
  echo "$arr"
}

format_event() {
  jq -r '
    "ID:        " + .id,
    "Title:     " + (.summary // "—"),
    "Start:     " + (.start.dateTime // .start.date // "—"),
    "End:       " + (.end.dateTime // .end.date // "—"),
    "Recurring: " + (if (.recurrence // empty) then "yes (series)" elif (.recurringEventId // empty) then "yes (instance of " + .recurringEventId + ")" else "no" end),
    "Meet:      " + (if .hangoutLink then .hangoutLink else "—" end),
    "Attendees: " + (if .attendees then ([.attendees[].email] | join(", ")) else "—" end),
    "Link:      " + (.htmlLink // "—"),
    ""
  '
}

# Recurring classification: prints "series", "instance", or "none"
classify_recurring() {
  local json="$1"
  local has_recurrence has_parent
  has_recurrence=$(echo "$json" | jq -r '(.recurrence // empty) | tostring' 2>/dev/null || true)
  has_parent=$(echo "$json" | jq -r '.recurringEventId // empty' 2>/dev/null || true)
  if [[ -n "$has_parent" ]]; then
    echo "instance"
  elif [[ -n "$has_recurrence" && "$has_recurrence" != "null" && "$has_recurrence" != "" ]]; then
    echo "series"
  else
    echo "none"
  fi
}

# --- Commands ---

cmd_list() {
  local from="" to="" json=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from) from="$2"; shift 2 ;;
      --to)   to="$2"; shift 2 ;;
      --cal)  OPT_CAL="$2"; shift 2 ;;
      --tz)   OPT_TZ="$2"; shift 2 ;;
      --json) json=true; shift ;;
      *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
  done
  [[ -z "$from" ]] && from=$(date '+%Y-%m-%d')
  [[ -z "$to" ]] && to=$(date -d "+7 days" '+%Y-%m-%d')
  from=$(parse_date "$from") || exit 1
  to=$(parse_date "$to") || exit 1
  local time_min="${from}T00:00:00Z"
  local time_max="${to}T23:59:59Z"
  local result
  result=$(gcurl "${API}/calendars/$(cal_id)/events?timeMin=${time_min}&timeMax=${time_max}&singleEvents=true&orderBy=startTime&maxResults=250")
  if $json; then
    printf '%s\n' "$result"
    return
  fi
  echo "$result" | jq -r '.items[] |
    "ID:        " + .id,
    "Title:     " + (.summary // "—"),
    "Start:     " + (.start.dateTime // .start.date // "—"),
    "End:       " + (.end.dateTime // .end.date // "—"),
    "Recurring: " + (if (.recurringEventId // empty) then "yes" else "no" end),
    "Attendees: " + (if .attendees then ([.attendees[].email] | join(", ")) else "—" end),
    ""
  '
}

cmd_find() {
  [[ $# -lt 1 ]] && { echo "Usage: gcal find <query> [--from DATE] [--to DATE]" >&2; exit 1; }
  local query="$1"; shift
  local from="" to="" json=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from) from="$2"; shift 2 ;;
      --to)   to="$2"; shift 2 ;;
      --cal)  OPT_CAL="$2"; shift 2 ;;
      --tz)   OPT_TZ="$2"; shift 2 ;;
      --json) json=true; shift ;;
      *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
  done
  # Default window: current week (Monday..Sunday)
  [[ -z "$from" ]] && from="this-week"
  [[ -z "$to" ]] && to=$(date -d "$(parse_date this-week) +6 days" '+%Y-%m-%d')
  from=$(parse_date "$from") || exit 1
  to=$(parse_date "$to") || exit 1
  local time_min="${from}T00:00:00Z"
  local time_max="${to}T23:59:59Z"
  local q
  q=$(jq -rn --arg v "$query" '$v | @uri')
  local result
  result=$(gcurl "${API}/calendars/$(cal_id)/events?q=${q}&timeMin=${time_min}&timeMax=${time_max}&singleEvents=true&orderBy=startTime&maxResults=250")
  if $json; then
    printf '%s\n' "$result"
    return
  fi
  echo "$result" | jq -r '.items[] |
    "ID:        " + .id,
    "Title:     " + (.summary // "—"),
    "Start:     " + (.start.dateTime // .start.date // "—"),
    "End:       " + (.end.dateTime // .end.date // "—"),
    "Recurring: " + (if (.recurringEventId // empty) then "yes" else "no" end),
    "Attendees: " + (if .attendees then ([.attendees[].email] | join(", ")) else "—" end),
    ""
  '
}

cmd_get() {
  [[ $# -lt 1 ]] && { echo "Usage: gcal get <event-id>" >&2; exit 1; }
  local json=false eid=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=true; shift ;;
      --cal)  OPT_CAL="$2"; shift 2 ;;
      *)      eid="$1"; shift ;;
    esac
  done
  [[ -z "$eid" ]] && { echo "Usage: gcal get <event-id>" >&2; exit 1; }
  local result
  result=$(gcurl "${API}/calendars/$(cal_id)/events/${eid}")
  if $json; then
    printf '%s\n' "$result"
    return
  fi
  echo "$result" | format_event
}

# Run freeBusy and return raw JSON on stdout.
# Args: time_min_iso time_max_iso
freebusy_query() {
  local tmin="$1" tmax="$2"
  local body
  body=$(jq -n --arg min "$tmin" --arg max "$tmax" --arg cal "$(cal_id)" \
    '{timeMin:$min, timeMax:$max, items:[{id:$cal}]}')
  gcurl -X POST "${API}/freeBusy" -d "$body"
}

cmd_freebusy() {
  [[ $# -lt 1 ]] && { echo "Usage: gcal freebusy <date> [--time HH:MM-HH:MM]" >&2; exit 1; }
  local date_input="$1"; shift
  local time_range="09:00-18:00"
  local json=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --time) time_range="$2"; shift 2 ;;
      --cal)  OPT_CAL="$2"; shift 2 ;;
      --tz)   OPT_TZ="$2"; shift 2 ;;
      --json) json=true; shift ;;
      *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
  done
  local d
  d=$(parse_date "$date_input") || exit 1
  local start_t="${time_range%-*}"
  local end_t="${time_range#*-}"
  local tz
  tz=$(event_tz)
  # Convert local -> UTC ISO
  local tmin tmax
  tmin=$(TZ="$tz" date -d "${d} ${start_t}" -u '+%Y-%m-%dT%H:%M:%SZ')
  tmax=$(TZ="$tz" date -d "${d} ${end_t}" -u '+%Y-%m-%dT%H:%M:%SZ')
  local result
  result=$(freebusy_query "$tmin" "$tmax")
  if $json; then
    printf '%s\n' "$result"
    return
  fi
  local cal
  cal=$(cal_id)
  local count
  count=$(echo "$result" | jq -r --arg cal "$cal" '.calendars[$cal].busy | length')
  if [[ "$count" == "0" ]]; then
    echo "free (${d} ${start_t}-${end_t} ${tz})"
    return
  fi
  echo "busy (${d} ${start_t}-${end_t} ${tz}):"
  echo "$result" | jq -r --arg cal "$cal" '.calendars[$cal].busy[] | "  " + .start + "  ->  " + .end'
}

# Conflict check: returns 0 if clear, 1 if conflicts (printed to stderr)
check_conflict() {
  local start_dt="$1" end_dt="$2" tz="$3"
  local tmin tmax
  tmin=$(TZ="$tz" date -d "${start_dt/T/ }" -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null) || return 0
  tmax=$(TZ="$tz" date -d "${end_dt/T/ }" -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null) || return 0
  local result count cal
  cal=$(cal_id)
  result=$(freebusy_query "$tmin" "$tmax" 2>/dev/null) || return 0
  count=$(echo "$result" | jq -r --arg cal "$cal" '.calendars[$cal].busy | length' 2>/dev/null || echo 0)
  [[ "$count" == "0" ]] && return 0
  echo "Conflicts detected in ${start_dt} -> ${end_dt} (${tz}):" >&2
  echo "$result" | jq -r --arg cal "$cal" '.calendars[$cal].busy[] | "  " + .start + "  ->  " + .end' >&2
  return 1
}

cmd_create() {
  [[ $# -lt 3 ]] && { echo "Usage: gcal create <title> <date> <time> [opts]" >&2; exit 1; }
  local title="$1" date_in="$2" time="$3"; shift 3
  local duration=30 emails="" desc="" meet=false no_default_attendees=false
  local force=false dry_run=false json=false
  local end_time_explicit=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --duration)    duration="$2"; shift 2 ;;
      --end-time)    end_time_explicit="$2"; shift 2 ;;
      --emails)      emails="$2"; shift 2 ;;
      --desc)        desc="$2"; shift 2 ;;
      --meet)        meet=true; shift ;;
      --cal)         OPT_CAL="$2"; shift 2 ;;
      --tz)          OPT_TZ="$2"; shift 2 ;;
      --no-defaults) no_default_attendees=true; shift ;;
      --force)       force=true; shift ;;
      --dry-run)     dry_run=true; shift ;;
      --json)        json=true; shift ;;
      *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
  done

  local date
  date=$(parse_date "$date_in") || exit 1

  # Merge default attendees unless --no-defaults
  if ! $no_default_attendees && [[ -n "${DEFAULT_ATTENDEES:-}" ]]; then
    if [[ -n "$emails" ]]; then
      emails="${DEFAULT_ATTENDEES},${emails}"
    else
      emails="${DEFAULT_ATTENDEES}"
    fi
  fi

  local start_dt end_dt
  start_dt=$(iso_datetime "$date" "$time")
  if [[ -n "$end_time_explicit" ]]; then
    end_dt=$(iso_datetime "$date" "$end_time_explicit")
  else
    end_dt=$(add_minutes "$date" "$time" "$duration")
  fi

  local tz
  tz=$(event_tz)

  local body
  body=$(jq -n \
    --arg summary "$title" \
    --arg start "$start_dt" \
    --arg end "$end_dt" \
    --arg tz "$tz" \
    --arg desc "$desc" \
    '{
      summary: $summary,
      start: { dateTime: $start, timeZone: $tz },
      end: { dateTime: $end, timeZone: $tz },
      reminders: { useDefault: false, overrides: [{ method: "popup", minutes: 10 }] }
    } + (if $desc != "" then { description: $desc } else {} end)')

  if [[ -n "$emails" ]]; then
    local att_json
    att_json=$(attendees_json "$emails")
    body=$(echo "$body" | jq --argjson att "$att_json" '. + { attendees: $att }')
  fi

  local conf_param=""
  if $meet; then
    body=$(echo "$body" | jq '. + {
      conferenceData: {
        createRequest: {
          requestId: ("gcal-" + (now | tostring)),
          conferenceSolutionKey: { type: "hangoutsMeet" }
        }
      }
    }')
    conf_param="?conferenceDataVersion=1"
  fi

  if $dry_run; then
    echo "DRY RUN — would POST to ${API}/calendars/$(cal_id)/events${conf_param}" >&2
    echo "$body"
    return 0
  fi

  # Conflict detection
  if ! $force; then
    if ! check_conflict "$start_dt" "$end_dt" "$tz"; then
      echo "Aborting. Re-run with --force to create anyway." >&2
      exit 2
    fi
  fi

  local result
  result=$(gcurl -X POST "${API}/calendars/$(cal_id)/events${conf_param}" -d "$body")
  if $json; then
    printf '%s\n' "$result"
    return
  fi
  echo "$result" | format_event
  if $meet; then
    local meet_url
    meet_url=$(echo "$result" | jq -r '.hangoutLink // empty')
    [[ -n "$meet_url" ]] && echo "Meet: ${meet_url}"
  fi
}

cmd_update() {
  [[ $# -lt 1 ]] && { echo "Usage: gcal update <event-id> [opts]" >&2; exit 1; }
  local eid="$1"; shift
  local title="" date_in="" time="" duration="" end_time_explicit="" emails="" desc="" meet=""
  local json=false scope_instance=false scope_series=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title)     title="$2"; shift 2 ;;
      --date)      date_in="$2"; shift 2 ;;
      --time)      time="$2"; shift 2 ;;
      --duration)  duration="$2"; shift 2 ;;
      --end-time)  end_time_explicit="$2"; shift 2 ;;
      --emails)    emails="$2"; shift 2 ;;
      --desc)      desc="$2"; shift 2 ;;
      --meet)      meet=true; shift ;;
      --cal)       OPT_CAL="$2"; shift 2 ;;
      --tz)        OPT_TZ="$2"; shift 2 ;;
      --instance)  scope_instance=true; shift ;;
      --series)    scope_series=true; shift ;;
      --json)      json=true; shift ;;
      *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
  done

  # Fetch current event
  local current
  current=$(gcurl "${API}/calendars/$(cal_id)/events/${eid}")

  # Recurring safety gate
  local kind
  kind=$(classify_recurring "$current")
  local target_id="$eid"
  if [[ "$kind" != "none" ]]; then
    if $scope_instance && $scope_series; then
      echo "Error: --instance and --series are mutually exclusive." >&2
      exit 2
    fi
    if ! $scope_instance && ! $scope_series; then
      echo "Error: '${eid}' is a recurring ${kind}. Re-run with --instance (only this occurrence) or --series (whole recurring series)." >&2
      exit 2
    fi
    if $scope_series && [[ "$kind" == "instance" ]]; then
      # Follow back to the series master
      target_id=$(echo "$current" | jq -r '.recurringEventId')
      current=$(gcurl "${API}/calendars/$(cal_id)/events/${target_id}")
    fi
    # --instance on a series master doesn't make sense — but allowed; user will be editing the master
  fi

  local date=""
  if [[ -n "$date_in" ]]; then
    date=$(parse_date "$date_in") || exit 1
  fi

  local body="$current"

  [[ -n "$title" ]] && body=$(echo "$body" | jq --arg s "$title" '.summary = $s')
  [[ -n "$desc" ]] && body=$(echo "$body" | jq --arg d "$desc" '.description = $d')

  if [[ -n "$date" || -n "$time" ]]; then
    local cur_start cur_end cur_date cur_time cur_end_time
    cur_start=$(echo "$current" | jq -r '.start.dateTime')
    cur_end=$(echo "$current" | jq -r '.end.dateTime')
    cur_date=$(echo "$cur_start" | cut -dT -f1)
    cur_time=$(echo "$cur_start" | cut -dT -f2 | cut -c1-5)
    cur_end_time=$(echo "$cur_end" | cut -dT -f2 | cut -c1-5)

    local new_date="${date:-$cur_date}"
    local new_time="${time:-$cur_time}"

    local new_start new_end
    new_start=$(iso_datetime "$new_date" "$new_time")

    if [[ -n "$end_time_explicit" ]]; then
      new_end=$(iso_datetime "$new_date" "$end_time_explicit")
    elif [[ -n "$duration" ]]; then
      new_end=$(add_minutes "$new_date" "$new_time" "$duration")
    else
      # Preserve original duration
      local orig_dur
      orig_dur=$(( ($(date -d "${cur_end%[-+]*}" +%s) - $(date -d "${cur_start%[-+]*}" +%s)) / 60 ))
      new_end=$(add_minutes "$new_date" "$new_time" "$orig_dur")
    fi

    local tz
    tz=$(event_tz)
    body=$(echo "$body" | jq \
      --arg s "$new_start" --arg e "$new_end" --arg tz "$tz" \
      '.start = { dateTime: $s, timeZone: $tz } | .end = { dateTime: $e, timeZone: $tz }')
  fi

  if [[ -n "$emails" ]]; then
    local att_json
    att_json=$(attendees_json "$emails")
    body=$(echo "$body" | jq --argjson att "$att_json" '.attendees = $att')
  fi

  # Ensure 10min reminder
  body=$(echo "$body" | jq '.reminders = { useDefault: false, overrides: [{ method: "popup", minutes: 10 }] }')

  local conf_param=""
  if [[ "$meet" == "true" ]]; then
    local has_meet
    has_meet=$(echo "$current" | jq -r '.hangoutLink // empty')
    if [[ -z "$has_meet" ]]; then
      body=$(echo "$body" | jq '. + {
        conferenceData: {
          createRequest: {
            requestId: ("gcal-" + (now | tostring)),
            conferenceSolutionKey: { type: "hangoutsMeet" }
          }
        }
      }')
      conf_param="?conferenceDataVersion=1"
    fi
  fi

  local result
  result=$(gcurl -X PUT "${API}/calendars/$(cal_id)/events/${target_id}${conf_param}" -d "$body")
  if $json; then
    printf '%s\n' "$result"
    return
  fi
  echo "$result" | format_event
}

cmd_auth() {
  rm -f "$TOKEN_CACHE"
  local token
  token=$(do_oauth_flow) || { echo "Échec de l'authentification" >&2; exit 1; }
  echo "Authentification réussie. Token cache mis à jour."
}

cmd_delete() {
  [[ $# -lt 1 ]] && { echo "Usage: gcal delete <event-id> [--instance|--series]" >&2; exit 1; }
  local eid="$1"; shift
  local scope_instance=false scope_series=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --instance) scope_instance=true; shift ;;
      --series)   scope_series=true; shift ;;
      --cal)      OPT_CAL="$2"; shift 2 ;;
      *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
  done

  # Classify before deleting
  local current kind
  current=$(gcurl "${API}/calendars/$(cal_id)/events/${eid}")
  kind=$(classify_recurring "$current")

  local target_id="$eid"
  if [[ "$kind" != "none" ]]; then
    if $scope_instance && $scope_series; then
      echo "Error: --instance and --series are mutually exclusive." >&2
      exit 2
    fi
    if ! $scope_instance && ! $scope_series; then
      echo "Error: '${eid}' is a recurring ${kind}. Deleting it without a scope flag can wipe the entire series." >&2
      echo "Re-run with --instance (only this occurrence) or --series (whole recurring series)." >&2
      exit 2
    fi
    if $scope_series && [[ "$kind" == "instance" ]]; then
      target_id=$(echo "$current" | jq -r '.recurringEventId')
    fi
    # scope_instance on an instance id: DELETE as-is (API treats DELETE on instance id as cancelling that occurrence only)
  fi

  gcurl -X DELETE "${API}/calendars/$(cal_id)/events/${target_id}" -o /dev/null
  echo "Deleted: ${target_id}"
}

# --- Dispatch ---

CMD="$1"; shift
case "$CMD" in
  auth)           cmd_auth ;;
  list|ls)        cmd_list "$@" ;;
  find|search)    cmd_find "$@" ;;
  get|show)       cmd_get "$@" ;;
  freebusy|fb)    cmd_freebusy "$@" ;;
  create)         cmd_create "$@" ;;
  update)         cmd_update "$@" ;;
  delete|rm|del)  cmd_delete "$@" ;;
  help|-h|--help) usage ;;
  *) echo "Unknown command: $CMD" >&2; usage 1 ;;
esac
