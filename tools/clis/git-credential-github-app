#!/usr/bin/env node
// git-credential-github-app
//
// Git credential helper that mints a short-lived GitHub App installation access
// token on demand. Git calls this script with "get" written to stdin; we output
// "username=x-access-token\npassword=<token>\n" on stdout.
//
// Required env vars:
//   GITHUB_APP_ID                  – numeric App ID (e.g. 2063765)
//   GITHUB_APP_INSTALLATION_ID     – numeric installation ID (e.g. 88730394)
//   GITHUB_APP_PRIVATE_KEY_B64     – base64-encoded PEM private key

'use strict';

const crypto = require('crypto');
const https = require('https');
const fs = require('fs');

// Read what git sent us on stdin (host=, protocol=, etc.)
const lines = fs.readFileSync('/dev/stdin', 'utf8').trim().split('\n');
const input = Object.fromEntries(
  lines.filter(l => l.includes('=')).map(l => {
    const idx = l.indexOf('=');
    return [l.slice(0, idx), l.slice(idx + 1)];
  })
);

// Only handle github.com — pass through for anything else
if (input.host && !input.host.includes('github.com')) {
  process.exit(0);
}

const appId = process.env.GITHUB_APP_ID;
const installationId = process.env.GITHUB_APP_INSTALLATION_ID;
const privateKeyB64 = process.env.GITHUB_APP_PRIVATE_KEY_B64;

if (!appId || !installationId || !privateKeyB64) {
  process.stderr.write(
    'git-credential-github-app: GITHUB_APP_ID, GITHUB_APP_INSTALLATION_ID, ' +
    'and GITHUB_APP_PRIVATE_KEY_B64 must all be set\n'
  );
  process.exit(1);
}

let privateKey;
try {
  privateKey = Buffer.from(privateKeyB64, 'base64').toString('utf8');
} catch (e) {
  process.stderr.write('git-credential-github-app: failed to decode private key: ' + e.message + '\n');
  process.exit(1);
}

// Mint a GitHub App JWT (RS256, iat-60s / exp+600s to allow clock skew)
const now = Math.floor(Date.now() / 1000);
const header  = Buffer.from(JSON.stringify({ alg: 'RS256', typ: 'JWT' })).toString('base64url');
const payload = Buffer.from(JSON.stringify({ iat: now - 60, exp: now + 600, iss: appId })).toString('base64url');
const sigInput = `${header}.${payload}`;

let sig;
try {
  sig = crypto.createSign('RSA-SHA256').update(sigInput).sign(privateKey, 'base64url');
} catch (e) {
  process.stderr.write('git-credential-github-app: JWT signing failed: ' + e.message + '\n');
  process.exit(1);
}

const appJwt = `${sigInput}.${sig}`;

// Exchange the App JWT for an installation access token
const reqOptions = {
  hostname: 'api.github.com',
  path: `/app/installations/${installationId}/access_tokens`,
  method: 'POST',
  headers: {
    'Authorization': `Bearer ${appJwt}`,
    'Accept': 'application/vnd.github+json',
    'X-GitHub-Api-Version': '2022-11-28',
    'User-Agent': 'paperclip-git-credential-helper/1.0',
    'Content-Length': '0',
  },
};

const req = https.request(reqOptions, res => {
  let body = '';
  res.on('data', chunk => { body += chunk; });
  res.on('end', () => {
    let data;
    try {
      data = JSON.parse(body);
    } catch (e) {
      process.stderr.write('git-credential-github-app: invalid JSON response: ' + body + '\n');
      process.exit(1);
    }

    if (!data.token) {
      process.stderr.write(
        'git-credential-github-app: no token in response (HTTP ' + res.statusCode + '): ' + body + '\n'
      );
      process.exit(1);
    }

    process.stdout.write(`username=x-access-token\npassword=${data.token}\n`);
  });
});

req.on('error', e => {
  process.stderr.write('git-credential-github-app: request failed: ' + e.message + '\n');
  process.exit(1);
});

req.end();
