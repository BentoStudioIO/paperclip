{
  "name": "@paperclipai/plugin-email-responder",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Watches the shared contact@ inboxes over IMAP and drafts replies (draft-only, no send) for human review via Discord.",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps",
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps && tsc --noEmit"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "email",
    "imap",
    "automation"
  ],
  "author": "Paperclip",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.177",
    "imapflow": "^1.4.0",
    "mailparser": "^3.7.1"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "workspace:*",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^24.6.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
